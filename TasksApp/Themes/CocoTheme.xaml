<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======================================================== -->
    <!-- COCO / LAND OF THE DEAD & MARIGOLD BRIDGE THEME PALETTE   -->
    <!-- Miguel, Héctor, Dante, Cempasúchil Marigolds & Violet Twilight -->
    <!-- ======================================================== -->

    <SolidColorBrush x:Key="PrimeBlue" Color="#FF7E00" />          <!-- Vibrant Marigold Orange -->
    <SolidColorBrush x:Key="PrimeBlueDark" Color="#C01E35" />      <!-- Fiesta Crimson (Miguel's Hoodie) -->
    <SolidColorBrush x:Key="PrimeWarmWhite" Color="#FFFDF8" />     <!-- Calavera Bone White -->
    <SolidColorBrush x:Key="PrimeGold" Color="#FFB800" />          <!-- Golden Cempasúchil Yellow -->
    <SolidColorBrush x:Key="PrimeYellow" Color="#FFD633" />        <!-- Radiant Petal Yellow -->
    <SolidColorBrush x:Key="PrimeGray" Color="#FFFDF8" />          <!-- Bright Bone White Text -->
    <SolidColorBrush x:Key="PrimeDeepInk" Color="#16072C" />       <!-- Deep Nocturnal Purple -->
    <SolidColorBrush x:Key="PrimeBorder" Color="#FF7E00" />        <!-- Glowing Marigold Border -->
    <SolidColorBrush x:Key="PrimeSubtleBg" Color="#240B48" />      <!-- Land of the Dead Indigo/Violet -->

    <!-- Semantic App Brushes -->
    <SolidColorBrush x:Key="AppWindowBackground" Color="#16072C" /> <!-- Land of the Dead Night Sky -->
    
    <!-- Title Bar: Fiesta Crimson to Radiant Marigold Bridge Gradient -->
    <LinearGradientBrush x:Key="AppTitleBarBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C01E35" Offset="0.0" />
        <GradientStop Color="#FF7E00" Offset="0.45" />
        <GradientStop Color="#FFB800" Offset="0.85" />
        <GradientStop Color="#FFD633" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AppTitleBarForeground" Color="#FFFDF8" />
    <SolidColorBrush x:Key="AppTitleBarBorder" Color="#FF7E00" />
    <SolidColorBrush x:Key="AppPanelBackground" Color="#1E0C3A" />
    <SolidColorBrush x:Key="AppPanelBorder" Color="#FF7E00" />
    <SolidColorBrush x:Key="AppCardBackground" Color="#250F47" />
    <SolidColorBrush x:Key="AppCardBorder" Color="#FF7E00" />
    <SolidColorBrush x:Key="AppSurfaceBackground" Color="#331661" />
    <SolidColorBrush x:Key="AppTextForeground" Color="#FFFDF8" />
    <SolidColorBrush x:Key="AppMutedForeground" Color="#FFC27A" />   <!-- Soft Marigold Peach Text -->
    <SolidColorBrush x:Key="AppPrimaryColor" Color="#FF7E00" />     <!-- Marigold Orange -->
    <SolidColorBrush x:Key="AppAccentColor" Color="#FFB800" />      <!-- Golden Marigold -->
    <SolidColorBrush x:Key="AppAccentForeground" Color="#16072C" /> <!-- Dark Contrast for Gold -->
    <SolidColorBrush x:Key="AppHeaderAccentColor" Color="#FFB800" />
    <SolidColorBrush x:Key="AppDialogHeaderBorder" Color="#FF7E00" />

    <!-- Dimensions & Metrics -->
    <sys:Double x:Key="AppTitleBarHeight">46</sys:Double>
    <sys:Double x:Key="AppCaptionHeight">46</sys:Double>
    <sys:Double x:Key="AppTitleFontSize">18</sys:Double>
    <FontWeight x:Key="AppTitleFontWeight">Bold</FontWeight>
    <FontStyle x:Key="AppDisplayFontStyle">Normal</FontStyle>
    <Thickness x:Key="AppWindowFrameThickness">2</Thickness>
    <Thickness x:Key="AppPanelBorderThickness">1.5</Thickness>

    <!-- Typography: Playful, Musical & Festive -->
    <FontFamily x:Key="AppBaseFontFamily">Segoe UI, Montserrat, Arial Rounded MT Bold, sans-serif</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Century Gothic, Arial Rounded MT Bold, Trebuchet MS, sans-serif</FontFamily>
    <FontFamily x:Key="AppTitleFontFamily">Century Gothic, Arial Rounded MT Bold, Trebuchet MS, sans-serif</FontFamily>
    <FontFamily x:Key="AppMetricFontFamily">Impact, Arial Rounded MT Bold, sans-serif</FontFamily>

    <!-- Indicators -->
    <sys:Boolean x:Key="IsWin95">False</sys:Boolean>
    <Visibility x:Key="Win95OnlyVis">Collapsed</Visibility>
    <Visibility x:Key="ModernOnlyVis">Visible</Visibility>
    <sys:Boolean x:Key="IsCoco">True</sys:Boolean>
    <Visibility x:Key="CocoOnlyVis">Visible</Visibility>
    <Visibility x:Key="NotCocoVis">Collapsed</Visibility>

    <!-- Outer Window / Dialog Frame Style: Twilight Purple with Marigold Glow -->
    <Style x:Key="DialogOuterFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="#16072C" />
        <Setter Property="BorderBrush" Value="#FF7E00" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FFB800" Direction="0" ShadowDepth="0" BlurRadius="12" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox / Card Style: Mystical Violet Card with Warm Gold Accent Border -->
    <Style x:Key="AppGroupBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="#250F47" />
        <Setter Property="BorderBrush" Value="#FF7E00" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" BlurRadius="6" Opacity="0.4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sunken Container Style -->
    <Style x:Key="AppSunkenBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#1A0A33" />
        <Setter Property="BorderBrush" Value="#FF7E00" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Title Bar Buttons -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFDF8" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="46" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#30FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C01E35" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Title Bar Top Action Button (Bell & Settings) -->
    <Style x:Key="TitleBarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- Primary Action Button: Glowing Marigold Gradient with Bone White Text -->
    <Style x:Key="PrimaryActionBtn" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E63946" Offset="0.0" />
                    <GradientStop Color="#FF7E00" Offset="0.6" />
                    <GradientStop Color="#FFA500" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="#FFFDF8" />
        <Setter Property="FontFamily" Value="Century Gothic, Arial Rounded MT Bold, Segoe UI, sans-serif" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnFace" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF7E00" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.5" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnFace" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF7E00" Offset="0.0" />
                                        <GradientStop Color="#FFB800" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnFace" Property="Background" Value="#C01E35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Action Button: Twilight Violet with Marigold Border -->
    <Style x:Key="SecondaryActionBtn" TargetType="Button">
        <Setter Property="Background" Value="#250F47" />
        <Setter Property="Foreground" Value="#FFFDF8" />
        <Setter Property="BorderBrush" Value="#FF7E00" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="Century Gothic, Arial Rounded MT Bold, Segoe UI, sans-serif" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnFace" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnFace" Property="Background" Value="#FF7E00" />
                            <Setter Property="Foreground" Value="#16072C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnFace" Property="Background" Value="#C01E35" />
                            <Setter Property="Foreground" Value="#FFFDF8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset Pill Button -->
    <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionBtn}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Gold Action Button: Golden Cempasúchil with Deep Midnight Text -->
    <Style x:Key="GoldActionBtn" TargetType="Button">
        <Setter Property="Background" Value="#FFB800" />
        <Setter Property="Foreground" Value="#16072C" />
        <Setter Property="FontFamily" Value="Century Gothic, Arial Rounded MT Bold, Segoe UI, sans-serif" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFB800" Direction="0" ShadowDepth="0" BlurRadius="8" Opacity="0.5" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#FFD633" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#FF7E00" />
                            <Setter Property="Foreground" Value="#FFFDF8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard TextBox Style: Deep Twilight Well with Marigold Outline -->
    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#1A0A33" />
        <Setter Property="Foreground" Value="#FFFDF8" />
        <Setter Property="CaretBrush" Value="#FFB800" />
        <Setter Property="BorderBrush" Value="#FF7E00" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="Segoe UI, Montserrat, sans-serif" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD633" />
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FFB800" Direction="0" ShadowDepth="0" BlurRadius="6" Opacity="0.6" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox: Marigold Flower Border & Amber Check -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFFDF8" />
        <Setter Property="FontFamily" Value="Segoe UI, Montserrat, sans-serif" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="16" Height="16" BorderBrush="#FF7E00" BorderThickness="1.5" Background="#1A0A33" CornerRadius="4">
                            <Path x:Name="CheckMark" Data="M 3,7 L 6,11 L 13,3"
                                  Stroke="#FFB800" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" Margin="0,1,0,0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="#351269" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFD633" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton: Marigold Ring & Golden Core -->
    <Style TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFFDF8" />
        <Setter Property="FontFamily" Value="Segoe UI, Montserrat, sans-serif" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="#FF7E00" StrokeThickness="1.5" Fill="#1A0A33" />
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#FFB800" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="#FFD633" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
