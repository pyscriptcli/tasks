<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Windows 95 System Palette -->
    <SolidColorBrush x:Key="PrimeBlue" Color="#000080" />
    <SolidColorBrush x:Key="PrimeBlueDark" Color="#000050" />
    <SolidColorBrush x:Key="PrimeWarmWhite" Color="#C0C0C0" />
    <SolidColorBrush x:Key="PrimeGold" Color="#000080" />
    <SolidColorBrush x:Key="PrimeYellow" Color="#FFFF00" />
    <SolidColorBrush x:Key="PrimeGray" Color="#000000" />
    <SolidColorBrush x:Key="PrimeDeepInk" Color="#000000" />
    <SolidColorBrush x:Key="PrimeBorder" Color="#808080" />
    <SolidColorBrush x:Key="PrimeSubtleBg" Color="#C0C0C0" />

    <!-- Semantic App Brushes (Win95 3D) -->
    <SolidColorBrush x:Key="AppWindowBackground" Color="#C0C0C0" />
    
    <LinearGradientBrush x:Key="AppTitleBarBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000080" Offset="0.0" />
        <GradientStop Color="#1084D0" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AppTitleBarForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTitleBarBorder" Color="#808080" />
    <SolidColorBrush x:Key="AppPanelBackground" Color="#C0C0C0" />
    <SolidColorBrush x:Key="AppPanelBorder" Color="#808080" />
    <SolidColorBrush x:Key="AppCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppCardBorder" Color="#808080" />
    <SolidColorBrush x:Key="AppSurfaceBackground" Color="#C0C0C0" />
    <SolidColorBrush x:Key="AppTextForeground" Color="#000000" />
    <SolidColorBrush x:Key="AppMutedForeground" Color="#404040" />
    <SolidColorBrush x:Key="AppPrimaryColor" Color="#000080" />
    <SolidColorBrush x:Key="AppAccentColor" Color="#000080" />
    <SolidColorBrush x:Key="AppAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderAccentColor" Color="#000080" />
    <SolidColorBrush x:Key="AppDialogHeaderBorder" Color="#808080" />

    <!-- Dimensions & Metrics -->
    <sys:Double x:Key="AppTitleBarHeight">26</sys:Double>
    <sys:Double x:Key="AppCaptionHeight">26</sys:Double>
    <sys:Double x:Key="AppTitleFontSize">11</sys:Double>
    <FontWeight x:Key="AppTitleFontWeight">Bold</FontWeight>
    <FontStyle x:Key="AppDisplayFontStyle">Normal</FontStyle>
    <Thickness x:Key="AppWindowFrameThickness">3</Thickness>
    <Thickness x:Key="AppPanelBorderThickness">2</Thickness>

    <!-- Typography (Win95 System) -->
    <FontFamily x:Key="AppBaseFontFamily">MS Sans Serif, Tahoma, Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">MS Sans Serif, Tahoma, Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="AppTitleFontFamily">MS Sans Serif, Tahoma, Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="AppMetricFontFamily">MS Sans Serif, Tahoma, Segoe UI, Arial, sans-serif</FontFamily>

    <!-- Indicators -->
    <sys:Boolean x:Key="IsWin95">True</sys:Boolean>
    <Visibility x:Key="Win95OnlyVis">Visible</Visibility>
    <Visibility x:Key="ModernOnlyVis">Collapsed</Visibility>

    <!-- Outer Window / Dialog 3D Raised Frame Style -->
    <Style x:Key="DialogOuterFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="#C0C0C0" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0.0" />
                    <GradientStop Color="#DFDFDF" Offset="0.25" />
                    <GradientStop Color="#808080" Offset="0.75" />
                    <GradientStop Color="#000000" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3D Etched GroupBox / Card Style -->
    <Style x:Key="AppGroupBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="#C0C0C0" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#808080" Offset="0.0" />
                    <GradientStop Color="#000000" Offset="0.1" />
                    <GradientStop Color="#DFDFDF" Offset="0.9" />
                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3D Sunken Well / Container Style (for task list, notes, status bar) -->
    <Style x:Key="AppSunkenBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#808080" Offset="0.0" />
                    <GradientStop Color="#000000" Offset="0.15" />
                    <GradientStop Color="#DFDFDF" Offset="0.85" />
                    <GradientStop Color="#FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win95 Authentic 3D Raised Action Button -->
    <Style x:Key="PrimaryActionBtn" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontFamily" Value="MS Sans Serif, Tahoma, Segoe UI, sans-serif" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- Highlight: Top & Left -->
                        <Border x:Name="OuterHi" BorderThickness="1,1,0,0" BorderBrush="#FFFFFF" />
                        <!-- Shadow: Bottom & Right -->
                        <Border x:Name="OuterLo" BorderThickness="0,0,1,1" BorderBrush="#000000" />
                        <!-- Inner Highlight: Top & Left -->
                        <Border x:Name="InnerHi" Margin="1" BorderThickness="1,1,0,0" BorderBrush="#DFDFDF" />
                        <!-- Inner Shadow: Bottom & Right -->
                        <Border x:Name="InnerLo" Margin="1" BorderThickness="0,0,1,1" BorderBrush="#808080" />
                        <!-- Content Presenter -->
                        <ContentPresenter x:Name="Presenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Tactile 3D depression when pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterHi" Property="BorderBrush" Value="#000000" />
                            <Setter TargetName="OuterLo" Property="BorderBrush" Value="#FFFFFF" />
                            <Setter TargetName="InnerHi" Property="BorderBrush" Value="#808080" />
                            <Setter TargetName="InnerLo" Property="BorderBrush" Value="#DFDFDF" />
                            <Setter TargetName="Presenter" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Action Button (Same 3D Bevel in Win95) -->
    <Style x:Key="SecondaryActionBtn" TargetType="Button" BasedOn="{StaticResource PrimaryActionBtn}" />
    <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionBtn}" />
    <Style x:Key="GoldActionBtn" TargetType="Button" BasedOn="{StaticResource PrimaryActionBtn}" />

    <!-- Win95 Square 3D Title Bar Caption Buttons (_ □ ✕) -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="#C0C0C0" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="#C0C0C0">
                        <Border x:Name="OuterHi" BorderThickness="1,1,0,0" BorderBrush="#FFFFFF" />
                        <Border x:Name="OuterLo" BorderThickness="0,0,1,1" BorderBrush="#000000" />
                        <Border x:Name="InnerHi" Margin="1" BorderThickness="1,1,0,0" BorderBrush="#DFDFDF" />
                        <Border x:Name="InnerLo" Margin="1" BorderThickness="0,0,1,1" BorderBrush="#808080" />
                        <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterHi" Property="BorderBrush" Value="#000000" />
                            <Setter TargetName="OuterLo" Property="BorderBrush" Value="#FFFFFF" />
                            <Setter TargetName="InnerHi" Property="BorderBrush" Value="#808080" />
                            <Setter TargetName="InnerLo" Property="BorderBrush" Value="#DFDFDF" />
                            <Setter TargetName="Presenter" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}" />

    <!-- Win95 Sunken TextBox Style -->
    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontFamily" Value="MS Sans Serif, Tahoma, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="#FFFFFF">
                        <!-- Sunken Bevel -->
                        <Border BorderThickness="1,1,0,0" BorderBrush="#808080" />
                        <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF" />
                        <Border Margin="1" BorderThickness="1,1,0,0" BorderBrush="#000000" />
                        <Border Margin="1" BorderThickness="0,0,1,1" BorderBrush="#DFDFDF" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="3" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win95 Sunken CheckBox Style -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontFamily" Value="MS Sans Serif, Tahoma, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                            <!-- Sunken Outer: Top/Left DarkGray, Bottom/Right White -->
                            <Border BorderThickness="1,1,0,0" BorderBrush="#808080" />
                            <Border BorderThickness="0,0,1,1" BorderBrush="#FFFFFF" />
                            <!-- Sunken Inner: Top/Left Black, Bottom/Right LightGray -->
                            <Border Margin="1" BorderThickness="1,1,0,0" BorderBrush="#000000" />
                            <Border Margin="1" BorderThickness="0,0,1,1" BorderBrush="#DFDFDF" />
                            <!-- White Face -->
                            <Border Margin="2" Background="#FFFFFF" />
                            <!-- Sharp Black Checkmark -->
                            <Path x:Name="CheckGlyph" Data="M 3,6 L 5,8 L 10,2"
                                  Stroke="#000000" StrokeThickness="1.8"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                  Visibility="Collapsed" Margin="0,1,0,0" />
                        </Grid>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Win95 Sunken RadioButton Style -->
    <Style TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontFamily" Value="MS Sans Serif, Tahoma, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                            <Ellipse Stroke="#808080" StrokeThickness="1" Fill="#FFFFFF" />
                            <Ellipse Margin="1" Stroke="#000000" StrokeThickness="1" Fill="#FFFFFF" />
                            <Ellipse x:Name="Dot" Width="5" Height="5" Fill="#000000" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
