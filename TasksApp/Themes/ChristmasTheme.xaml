<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======================================================== -->
    <!-- CHRISTMAS (SANTA'S COZY HEARTH & WORKSHOP) THEME PALETTE  -->
    <!-- Santa Crimson, Garland Pine, Jingle Bell Gold & Pure White -->
    <!-- ======================================================== -->

    <SolidColorBrush x:Key="PrimeBlue" Color="#D32F2F" />          <!-- Santa Crimson Red -->
    <SolidColorBrush x:Key="PrimeBlueDark" Color="#8B0000" />      <!-- Deep Velvet Red -->
    <SolidColorBrush x:Key="PrimeWarmWhite" Color="#FFFFFF" />     <!-- Crisp Solid White -->
    <SolidColorBrush x:Key="PrimeGold" Color="#FFD700" />          <!-- Jingle Bell Gold -->
    <SolidColorBrush x:Key="PrimeYellow" Color="#FFF176" />        <!-- Warm Hearth Star Glow -->
    <SolidColorBrush x:Key="PrimeGray" Color="#121212" />          <!-- Deep Charcoal Text -->
    <SolidColorBrush x:Key="PrimeDeepInk" Color="#070D1B" />       <!-- Midnight Winter Night Sky -->
    <SolidColorBrush x:Key="PrimeBorder" Color="#D32F2F" />        <!-- Festive Crimson Border -->
    <SolidColorBrush x:Key="PrimeSubtleBg" Color="#0D182E" />      <!-- Deep Pine/Midnight Tint -->

    <!-- Semantic App Brushes: Solid Colors for Distinct Layout Boxes (No Gradients) -->
    <SolidColorBrush x:Key="AppWindowBackground" Color="#0B132B" /> <!-- Solid Deep Midnight Winter Sky (Canvas Box) -->
    
    <!-- Title Bar Box: Solid Santa Crimson Red with Jingle Bell Gold Border -->
    <SolidColorBrush x:Key="AppTitleBarBackground" Color="#B71C1C" />
    <SolidColorBrush x:Key="AppTitleBarForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTitleBarBorder" Color="#FFD700" />

    <!-- Date Navigation & Toolbar Box: Solid Evergreen Forest Pine -->
    <SolidColorBrush x:Key="AppPanelBackground" Color="#153E23" />
    <SolidColorBrush x:Key="AppPanelBorder" Color="#2E7D32" />
    <SolidColorBrush x:Key="AppToolbarForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppToolbarMutedForeground" Color="#FFD700" />
    
    <!-- Task Cards & Daily Notes Wells: Solid Pure White (#FFFFFF) with #121212 text -->
    <SolidColorBrush x:Key="AppCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppCardBorder" Color="#D32F2F" />
    <SolidColorBrush x:Key="AppSurfaceBackground" Color="#FFFDF8" />
    <SolidColorBrush x:Key="AppTextForeground" Color="#121212" />     <!-- High-contrast dark text on white cards -->
    <SolidColorBrush x:Key="AppMutedForeground" Color="#555555" />    <!-- Muted text on white cards -->
    <SolidColorBrush x:Key="AppPrimaryColor" Color="#D32F2F" />      <!-- Santa Crimson -->
    <SolidColorBrush x:Key="AppAccentColor" Color="#FFD700" />       <!-- Jingle Bell Gold -->
    <SolidColorBrush x:Key="AppAccentForeground" Color="#000000" />
    <SolidColorBrush x:Key="AppHeaderAccentColor" Color="#FFD700" />
    <SolidColorBrush x:Key="AppDialogHeaderBorder" Color="#D32F2F" />

    <!-- High-Contrast Dialog & Reminder Text Brushes (Readable against dark Santa crimson) -->
    <SolidColorBrush x:Key="AppDialogTitleForeground" Color="#FFD700" />  <!-- Jingle Bell Gold on #7A0C0C (~8.9:1) -->
    <SolidColorBrush x:Key="AppDialogTextForeground" Color="#FFFFFF" />   <!-- Pure White on #7A0C0C (~11.0:1) -->
    <SolidColorBrush x:Key="AppDialogMutedForeground" Color="#FFE9B0" />  <!-- Soft Warm Cream on #7A0C0C (~9.2:1) -->

    <!-- Distinct Layout Box Brushes (Different Colors for Different Layout Boxes) -->
    <SolidColorBrush x:Key="AppTasksHeaderBackground" Color="#FFF8F8" /> <!-- Solid Soft Crimson Hearth Tint -->
    <SolidColorBrush x:Key="AppNotesHeaderBackground" Color="#F2F9F4" /> <!-- Solid Soft Pine Mist Tint -->
    <SolidColorBrush x:Key="AppTasksBorder" Color="#D32F2F" />           <!-- Solid Santa Crimson Border -->
    <SolidColorBrush x:Key="AppNotesBorder" Color="#2E7D32" />           <!-- Solid Evergreen Pine Border -->
    <SolidColorBrush x:Key="AppStatusBarBackground" Color="#091A14" />   <!-- Solid Deep Winter Spruce Footer Box -->
    <SolidColorBrush x:Key="AppStatusBarBorder" Color="#1B5E20" />

    <!-- Dimensions & Metrics -->
    <sys:Double x:Key="AppTitleBarHeight">48</sys:Double>
    <sys:Double x:Key="AppCaptionHeight">48</sys:Double>
    <sys:Double x:Key="AppTitleFontSize">18</sys:Double>
    <FontWeight x:Key="AppTitleFontWeight">Bold</FontWeight>
    <FontStyle x:Key="AppDisplayFontStyle">Normal</FontStyle>
    <Thickness x:Key="AppWindowFrameThickness">2</Thickness>
    <Thickness x:Key="AppPanelBorderThickness">1.5</Thickness>

    <!-- Typography -->
    <FontFamily x:Key="AppBaseFontFamily">Segoe UI, Montserrat, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Century Gothic, Georgia, 'Times New Roman', sans-serif</FontFamily>
    <FontFamily x:Key="AppTitleFontFamily">Century Gothic, Georgia, 'Times New Roman', sans-serif</FontFamily>
    <FontFamily x:Key="AppMetricFontFamily">Impact, Arial Black, sans-serif</FontFamily>

    <!-- Indicators -->
    <sys:Boolean x:Key="IsWin95">False</sys:Boolean>
    <Visibility x:Key="Win95OnlyVis">Collapsed</Visibility>
    <Visibility x:Key="ModernOnlyVis">Visible</Visibility>
    <sys:Boolean x:Key="IsHalloween">False</sys:Boolean>
    <Visibility x:Key="HalloweenOnlyVis">Collapsed</Visibility>
    <Visibility x:Key="NotHalloweenVis">Visible</Visibility>
    <sys:Boolean x:Key="IsChristmas">True</sys:Boolean>
    <Visibility x:Key="ChristmasOnlyVis">Visible</Visibility>
    <Visibility x:Key="NotChristmasVis">Collapsed</Visibility>

    <!-- Outer Window / Dialog Frame Style: Solid Deep Santa Velvet Red with Solid Gold Trim (No Gradients) -->
    <Style x:Key="DialogOuterFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="#7A0C0C" />
        <Setter Property="BorderBrush" Value="#FFD700" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.65" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox Style: Pure White Well with Festive Crimson Border -->
    <Style x:Key="AppGroupBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D32F2F" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#D32F2F" Direction="270" ShadowDepth="2" BlurRadius="6" Opacity="0.25" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sunken Container Style: Solid White Well -->
    <Style x:Key="AppSunkenBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D32F2F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Title Bar Buttons -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="48" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#40D32F2F" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D32F2F" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Title Bar Top Action Button (Bell & Settings) -->
    <Style x:Key="TitleBarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- Primary Action Button: Solid Santa Crimson with Gold Accent (No Gradients) -->
    <Style x:Key="PrimaryActionBtn" TargetType="Button">
        <Setter Property="Background" Value="#C62828" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Century Gothic, Segoe UI, sans-serif" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD700" Direction="0" ShadowDepth="0" BlurRadius="6" Opacity="0.4" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#D32F2F" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#8B0000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Action Button: Solid Evergreen Forest Pine with Emerald Hover -->
    <Style x:Key="SecondaryActionBtn" TargetType="Button">
        <Setter Property="Background" Value="#153E23" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#2E7D32" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="Century Gothic, Segoe UI, sans-serif" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#2E7D32" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#0C2B16" />
                            <Setter Property="Foreground" Value="#FFE082" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset Pill Button -->
    <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionBtn}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Gold Action Button: Jingle Bell Gold -->
    <Style x:Key="GoldActionBtn" TargetType="Button" BasedOn="{StaticResource PrimaryActionBtn}">
        <Setter Property="Background" Value="#FFD700" />
        <Setter Property="Foreground" Value="#000000" />
    </Style>

    <!-- Text stays dark on the white entry surface; evergreen focus remains distinct and visible. -->
    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#121212" />
        <Setter Property="CaretBrush" Value="#D32F2F" />
        <Setter Property="SelectionBrush" Value="#D32F2F" />
        <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D32F2F" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="FontFamily" Value="Segoe UI, Montserrat, sans-serif" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <!-- The custom template must pass the input color into its text rendering host. -->
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2E7D32" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox: Santa Crimson Border with Evergreen Check -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#121212" />
        <Setter Property="FontFamily" Value="Segoe UI, Montserrat, sans-serif" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="16" Height="16" BorderBrush="#D32F2F" BorderThickness="1.5" Background="#FFFFFF" CornerRadius="4">
                            <Path x:Name="CheckMark" Data="M 3,7 L 6,11 L 13,3"
                                  Stroke="#2E7D32" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" Margin="0,1,0,0" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#FFD700" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton: Evergreen Ring & Santa Crimson Dot -->
    <Style TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#121212" />
        <Setter Property="FontFamily" Value="Segoe UI, Montserrat, sans-serif" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="#2E7D32" StrokeThickness="1.5" Fill="#FFFFFF" />
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#D32F2F" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="#FFD700" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
