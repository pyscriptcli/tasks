<Window x:Class="TasksApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="740" Height="540"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="{DynamicResource AppWindowBackground}"
        FontFamily="{DynamicResource AppBaseFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource AppCaptionHeight}"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- Outer Frame (Authentic 3D Bevel in Win95, Sleek Border in Modern) -->
    <Border Style="{DynamicResource DialogOuterFrameStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Custom Title Bar -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Window Title Bar -->
            <Border Grid.Row="0" Height="{DynamicResource AppTitleBarHeight}"
                    Background="{DynamicResource AppTitleBarBackground}"
                    BorderBrush="{DynamicResource AppTitleBarBorder}"
                    BorderThickness="0,0,0,1" Padding="8,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 16x16 Yellow Note / App Icon -->
                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,3 L 15,3 L 21,9 L 21,21 L 3,21 Z" Fill="#FFD700" />
                                <Path Data="M 15,3 L 15,9 L 21,9" Fill="#D4AF37" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Settings"
                                   FontFamily="{DynamicResource AppTitleFontFamily}"
                                   FontSize="{DynamicResource AppTitleFontSize}"
                                   FontWeight="{DynamicResource AppTitleFontWeight}"
                                   Foreground="{DynamicResource AppTitleBarForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" Style="{DynamicResource TitleBarCloseButtonStyle}"
                            Click="OnCancelClick" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Modern Vector Icon -->
                        <Grid>
                            <Viewbox Width="10" Height="10" Visibility="{DynamicResource ModernOnlyVis}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 5,5 L 19,19 M 19,5 L 5,19"
                                          Stroke="{DynamicResource AppTitleBarForeground}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                            <!-- Win95 Retro ✕ Glyph -->
                            <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{DynamicResource Win95OnlyVis}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Content Sections -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel>
                    <!-- Section: Appearance & Theme -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE &amp; THEME" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <TextBlock Text="Choose between the modern PRIME Sovereign look and the authentic 1995 retro desktop experience."
                                       FontSize="11" Foreground="{DynamicResource AppTextForeground}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Modern Default Card -->
                                <Border Grid.Column="0" BorderBrush="{DynamicResource AppCardBorder}" BorderThickness="1"
                                        Background="{DynamicResource AppCardBackground}" Padding="10" Margin="0,0,6,0">
                                    <RadioButton x:Name="RbThemeDefault" GroupName="AppThemeGroup" Cursor="Hand" Checked="OnThemeRadioChecked">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="PRIME Sovereign" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppPrimaryColor}" />
                                            <TextBlock Text="Modern minimalist styling with deep blue, gold, and editorial typography."
                                                       FontSize="11" Foreground="{DynamicResource AppMutedForeground}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>

                                <!-- Windows 95 Card -->
                                <Border Grid.Column="1" BorderBrush="#808080" BorderThickness="2"
                                        Background="#C0C0C0" Padding="10" Margin="6,0,0,0">
                                    <RadioButton x:Name="RbThemeWin95" GroupName="AppThemeGroup" Cursor="Hand" Checked="OnThemeRadioChecked">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Windows 95" FontSize="12" FontWeight="Bold" Foreground="#000080"
                                                       FontFamily="MS Sans Serif, Tahoma, Arial, sans-serif" />
                                            <TextBlock Text="Authentic 1995 desktop with 3D beveled silver frames, navy title bars, and sunken controls."
                                                       FontSize="11" Foreground="#000000" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section: Storage Location -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="STORAGE LOCATION" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <TextBlock Text="Files for daily tasks and notes are stored as readable files in this directory."
                                       FontSize="11" Foreground="{DynamicResource AppTextForeground}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtStoragePath" Grid.Column="0" Height="28"
                                         Style="{DynamicResource AppTextBoxStyle}" />
                                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Height="28"
                                        Style="{DynamicResource SecondaryActionBtn}" Click="OnBrowseStorageClick" />
                            </Grid>

                            <CheckBox x:Name="ChkMigrateFiles" Content="Copy existing tasks and notes to new folder if changed"
                                      FontSize="11" Foreground="{DynamicResource AppTextForeground}" IsChecked="True" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Task Reminders -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="TASK REMINDERS" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <TextBlock Text="Periodically brings up a summary of today's tasks so you never lose track of open work."
                                       FontSize="11" Foreground="{DynamicResource AppTextForeground}" Margin="0,0,0,10" />

                            <!-- Toggle -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="ChkRemindersEnabled" VerticalAlignment="Center" Cursor="Hand" />
                                <TextBlock Text="Enable task reminders" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppPrimaryColor}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Cursor="Hand" MouseLeftButtonDown="OnToggleRemindersLabelClick" />
                            </StackPanel>

                            <!-- Interval Inputs -->
                            <TextBlock Text="REMINDER INTERVAL" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextForeground}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Hours" FontSize="10" Foreground="{DynamicResource AppMutedForeground}" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtHours" Width="60" Height="28" TextAlignment="Center"
                                             Style="{DynamicResource AppTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Minutes" FontSize="10" Foreground="{DynamicResource AppMutedForeground}" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtMinutes" Width="60" Height="28" TextAlignment="Center"
                                             Style="{DynamicResource AppTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Seconds" FontSize="10" Foreground="{DynamicResource AppMutedForeground}" Margin="0,0,0,2" />
                                    <TextBox x:Name="TxtSeconds" Width="60" Height="28" TextAlignment="Center"
                                             Style="{DynamicResource AppTextBoxStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Presets -->
                            <TextBlock Text="PRESETS" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextForeground}" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="15 MIN" Style="{DynamicResource PresetButtonStyle}" Click="OnPreset15MinClick" />
                                <Button Content="30 MIN" Style="{DynamicResource PresetButtonStyle}" Click="OnPreset30MinClick" />
                                <Button Content="1 HOUR" Style="{DynamicResource PresetButtonStyle}" Click="OnPreset1HourClick" />
                                <Button Content="2 HOURS" Style="{DynamicResource PresetButtonStyle}" Click="OnPreset2HoursClick" />
                                <Button Content="4 HOURS" Style="{DynamicResource PresetButtonStyle}" Click="OnPreset4HoursClick" />
                            </WrapPanel>

                            <TextBlock x:Name="TxtIntervalError" Text="" Foreground="#C02020" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Window Behavior -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="WINDOW BEHAVIOR" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkAlwaysOnTop" VerticalAlignment="Center" Cursor="Hand" />
                                <TextBlock Text="Keep window always on top (off by default)" FontSize="11"
                                           Foreground="{DynamicResource AppTextForeground}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Cursor="Hand" MouseLeftButtonDown="OnToggleAlwaysOnTopLabelClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Software Updates -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="SOFTWARE UPDATES" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <TextBlock Text="Check GitHub repository (pyscriptcli/tasks) for new releases and updates."
                                       FontSize="11" Foreground="{DynamicResource AppTextForeground}" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <TextBlock Text="CURRENT VERSION:" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppPanelBorder}"
                                        BorderThickness="1" Padding="6,2" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AppPrimaryColor}" />
                                </Border>

                                <Button x:Name="BtnCheckUpdates" Content="CHECK FOR UPDATES"
                                        Style="{DynamicResource SecondaryActionBtn}"
                                        Padding="10,4" FontSize="11" Click="OnCheckUpdatesClick" />
                            </StackPanel>

                            <!-- Status text -->
                            <TextBlock x:Name="TxtUpdateStatus" Text="" FontSize="11" Foreground="{DynamicResource AppPrimaryColor}" Margin="0,4,0,0"
                                       Visibility="Collapsed" TextWrapping="Wrap" />

                            <!-- Progress Bar during download -->
                            <ProgressBar x:Name="PbUpdateProgress" Height="6" Margin="0,8,0,4" Minimum="0" Maximum="100"
                                         Foreground="{DynamicResource AppPrimaryColor}" Background="{DynamicResource AppSurfaceBackground}"
                                         BorderThickness="1" BorderBrush="{DynamicResource AppPanelBorder}" Visibility="Collapsed" />

                            <!-- Available Update Panel -->
                            <Border x:Name="PnlUpdateAvailable" BorderBrush="{DynamicResource AppAccentColor}" BorderThickness="1"
                                    Background="{DynamicResource AppSurfaceBackground}"
                                    Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="UPDATE READY:" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppAccentColor}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="TxtNewVersionTag" Text="v1.1.0" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppPrimaryColor}" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtReleaseNotes" Text="" FontSize="11" Foreground="{DynamicResource AppTextForeground}"
                                               Margin="0,0,0,8" TextWrapping="Wrap" MaxHeight="80" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnInstallUpdate" Content="DOWNLOAD &amp; INSTALL UPDATE"
                                                Style="{DynamicResource PrimaryActionBtn}" Padding="12,6" FontSize="11"
                                                Click="OnInstallUpdateClick" />
                                        <Button x:Name="BtnViewReleasePage" Content="VIEW ON GITHUB"
                                                Style="{DynamicResource SecondaryActionBtn}" Margin="8,0,0,0" Padding="10,6" FontSize="11"
                                                Click="OnViewReleasePageClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Action Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Style="{DynamicResource SecondaryActionBtn}"
                            Margin="0,0,8,0" Padding="14,6" Click="OnCancelClick" />
                    <Button Content="SAVE PREFERENCES" Style="{DynamicResource PrimaryActionBtn}"
                            Padding="18,6" Click="OnSaveClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
