<Window x:Class="TasksApp.Views.TaskAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Task"
        Width="640" Height="480"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFFCFB"
        FontFamily="Montserrat, Segoe UI, sans-serif"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimeBlue" Color="#003366" />
        <SolidColorBrush x:Key="PrimeWarmWhite" Color="#FFFCFB" />
        <SolidColorBrush x:Key="PrimeGold" Color="#C9A84C" />
        <SolidColorBrush x:Key="PrimeGray" Color="#181D1E" />
        <SolidColorBrush x:Key="PrimeBorder" Color="#D2D6DC" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#003366" />
            <Setter Property="Foreground" Value="#FFFCFB" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#002244" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFCFB" />
            <Setter Property="Foreground" Value="#003366" />
            <Setter Property="BorderBrush" Value="#003366" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4F8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#003366" BorderThickness="0,0,0,2" Padding="0,0,0,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="NEW TASK" FontSize="11" FontWeight="Medium" Foreground="#C9A84C"
                           FontFamily="Montserrat, Segoe UI, sans-serif" Margin="0,0,0,2" />
                <TextBlock Text="Add Task" FontSize="24" FontWeight="Normal" Foreground="#003366"
                           FontFamily="Cormorant Garamond, Georgia, serif" />
            </StackPanel>
        </Border>

        <!-- Title Field -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="TITLE" FontSize="11" FontWeight="SemiBold" Foreground="#181D1E"
                       FontFamily="Montserrat, Segoe UI, sans-serif" Margin="0,0,0,4" />
            <TextBox x:Name="TxtTitle" Height="36" Padding="10,6" FontSize="13" Foreground="#0C0C0E"
                     FontFamily="Montserrat, Segoe UI, sans-serif"
                     Background="#FFFFFF" BorderBrush="#D2D6DC" BorderThickness="1"
                     VerticalContentAlignment="Center" KeyDown="OnTitleKeyDown" />
        </StackPanel>

        <!-- Date Field -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="DATE" FontSize="11" FontWeight="SemiBold" Foreground="#181D1E"
                       FontFamily="Montserrat, Segoe UI, sans-serif" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="DpTaskDate" Grid.Column="0" Height="36"
                            FontFamily="Montserrat, Segoe UI, sans-serif" FontSize="13"
                            BorderBrush="#D2D6DC" BorderThickness="1" Background="#FFFFFF"
                            VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="TODAY" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" Height="36" Padding="12,0" Click="OnDateTodayClick" />
                <Button Grid.Column="2" Content="TOMORROW" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="6,0,0,0" Height="36" Padding="12,0" Click="OnDateTomorrowClick" />
            </Grid>
        </StackPanel>

        <!-- Details Field -->
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="DETAILS (OPTIONAL)" FontSize="11" FontWeight="SemiBold" Foreground="#181D1E"
                       FontFamily="Montserrat, Segoe UI, sans-serif" Margin="0,0,0,4" />
            <TextBox x:Name="TxtDetails" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Montserrat, Segoe UI, sans-serif"
                     Padding="10,8" FontSize="13" Foreground="#0C0C0E" Background="#FFFFFF"
                     BorderBrush="#D2D6DC" BorderThickness="1" VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!-- Priority Option -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
            <CheckBox x:Name="ChkHighPriority" VerticalAlignment="Center" Cursor="Hand">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                </CheckBox.LayoutTransform>
            </CheckBox>
            <TextBlock Text="Mark as high priority" FontSize="13" FontWeight="SemiBold" Foreground="#003366"
                       FontFamily="Montserrat, Segoe UI, sans-serif"
                       Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnPriorityLabelClick" />
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnCancelClick" />
            <Button Content="ADD TASK" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddClick" />
        </StackPanel>
    </Grid>
</Window>
