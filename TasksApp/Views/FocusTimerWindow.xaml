<Window x:Class="TasksApp.Views.FocusTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Timer" Width="300" Height="176" MinWidth="260" MinHeight="156"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackground}" FontFamily="{DynamicResource AppBaseFontFamily}">
    <Window.Resources>
        <Style x:Key="FocusIconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppToolbarForeground}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource AppPanelBackground}"
            BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="1" Padding="14,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TaskTitleText" Grid.Row="0" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppToolbarForeground}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

            <TextBlock x:Name="ElapsedText" Grid.Row="1" Text="00:00:00" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="34" FontWeight="SemiBold"
                       FontFamily="{DynamicResource AppMetricFontFamily}"
                       Foreground="{DynamicResource AppToolbarForeground}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PauseResumeButton" Style="{StaticResource FocusIconButton}"
                        AutomationProperties.Name="Pause" ToolTip="Pause"
                        Click="OnPauseResumeClick">
                    <TextBlock x:Name="PauseResumeIcon" Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button x:Name="FinishButton" Style="{StaticResource FocusIconButton}"
                        AutomationProperties.Name="Finish focus session" ToolTip="Finish session"
                        Click="OnFinishClick">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Button x:Name="HideButton" Style="{StaticResource FocusIconButton}"
                        AutomationProperties.Name="Hide focus timer" ToolTip="Hide timer"
                        Click="OnHideClick">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
