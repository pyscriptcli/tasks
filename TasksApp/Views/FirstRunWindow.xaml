<Window x:Class="TasksApp.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasks - Setup Storage"
        Width="640" Height="400"
        MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="{DynamicResource AppWindowBackground}"
        FontFamily="{DynamicResource AppBaseFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource AppCaptionHeight}"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource DialogOuterFrameStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Custom Title Bar -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Window Title Bar -->
            <Border Grid.Row="0" Height="{DynamicResource AppTitleBarHeight}"
                    Background="{DynamicResource AppTitleBarBackground}"
                    BorderBrush="{DynamicResource AppTitleBarBorder}"
                    BorderThickness="0,0,0,1" Padding="8,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 10,4 L 4,4 C 2.9,4 2,4.9 2,6 L 2,18 C 2,19.1 2.9,20 4,20 L 20,20 C 21.1,20 22,19.1 22,18 L 22,8 C 22,6.9 21.1,6 20,6 L 12,6 L 10,4 Z" Fill="#FFD700" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Welcome - Setup Storage"
                                   FontFamily="{DynamicResource AppTitleFontFamily}"
                                   FontSize="{DynamicResource AppTitleFontSize}"
                                   FontWeight="{DynamicResource AppTitleFontWeight}"
                                   Foreground="{DynamicResource AppTitleBarForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{DynamicResource TitleBarCloseButtonStyle}"
                            Click="OnCloseClick" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Viewbox Width="10" Height="10" Visibility="{DynamicResource ModernOnlyVis}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 5,5 L 19,19 M 19,5 L 5,19"
                                          Stroke="{DynamicResource AppTitleBarForeground}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{DynamicResource Win95OnlyVis}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="DATA FOLDER" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <TextBlock Text="Tasks and daily notes will be saved as readable files in this folder. You can change this location at any time from Settings."
                                       Foreground="{DynamicResource AppTextForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFolderPath" Grid.Column="0"
                                         Height="30" FontSize="12"
                                         Style="{DynamicResource AppTextBoxStyle}" />
                                <Button Grid.Column="1" Content="BROWSE..." Margin="8,0,0,0" Height="30"
                                        Style="{DynamicResource SecondaryActionBtn}" Click="OnBrowseClick" />
                            </Grid>
                            <TextBlock x:Name="TxtError" Text="" Foreground="#C02020" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Actions -->
            <Border Grid.Row="2" Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="GET STARTED" Style="{DynamicResource PrimaryActionBtn}"
                            Padding="20,6" Click="OnGetStartedClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
