<Window x:Class="TasksApp.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasks - Setup Storage"
        Width="640" Height="380"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FFFCFB"
        FontFamily="Montserrat, Segoe UI, sans-serif"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimeBlue" Color="#003366" />
        <SolidColorBrush x:Key="PrimeWarmWhite" Color="#FFFCFB" />
        <SolidColorBrush x:Key="PrimeGold" Color="#C9A84C" />
        <SolidColorBrush x:Key="PrimeGray" Color="#181D1E" />
        <SolidColorBrush x:Key="PrimeBorder" Color="#D2D6DC" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#003366" />
            <Setter Property="Foreground" Value="#FFFCFB" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#002244" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFCFB" />
            <Setter Property="Foreground" Value="#003366" />
            <Setter Property="BorderBrush" Value="#003366" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Montserrat, Segoe UI, sans-serif" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4F8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#003366" BorderThickness="0,0,0,2" Padding="0,0,0,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="STORAGE LOCATION"
                           FontSize="11" FontWeight="Medium" Foreground="#C9A84C"
                           FontFamily="Montserrat, Segoe UI, sans-serif"
                           Margin="0,0,0,4" />
                <TextBlock Text="Choose where your data will be saved"
                           FontSize="24" FontWeight="Normal" Foreground="#003366"
                           FontFamily="Cormorant Garamond, Georgia, serif" />
            </StackPanel>
        </Border>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   Text="Tasks and daily notes will be saved as readable files in this folder. You can change this location at any time from Settings."
                   Foreground="#181D1E" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />

        <!-- Path selection -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <TextBlock Text="DATA FOLDER" FontSize="11" FontWeight="SemiBold" Foreground="#181D1E"
                       FontFamily="Montserrat, Segoe UI, sans-serif" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFolderPath" Grid.Column="0"
                         FontFamily="Montserrat, Segoe UI, sans-serif"
                         Height="38" Padding="10,8" FontSize="13" Foreground="#0C0C0E"
                         Background="#FFFFFF" BorderBrush="#D2D6DC" BorderThickness="1"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="BROWSE..." Margin="8,0,0,0" Height="38"
                        Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseClick" />
            </Grid>
            <TextBlock x:Name="TxtError" Text="" Foreground="#C02020" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="GET STARTED" Style="{StaticResource PrimaryButtonStyle}" Click="OnGetStartedClick" />
        </StackPanel>
    </Grid>
</Window>
