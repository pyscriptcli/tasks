<Window x:Class="TasksApp.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task"
        Width="640" Height="480"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="{DynamicResource AppWindowBackground}"
        FontFamily="{DynamicResource AppBaseFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource AppCaptionHeight}"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource DialogOuterFrameStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Custom Title Bar -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Window Title Bar -->
            <Border Grid.Row="0" Height="{DynamicResource AppTitleBarHeight}"
                    Background="{DynamicResource AppTitleBarBackground}"
                    BorderBrush="{DynamicResource AppTitleBarBorder}"
                    BorderThickness="0,0,0,1" Padding="8,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,17.25 L 3,21 L 6.75,21 L 17.81,9.94 L 14.06,6.19 L 3,17.25 Z M 20.71,7.04 C 21.1,6.65 21.1,6.02 20.71,5.63 L 18.37,3.29 C 17.98,2.9 17.35,2.9 16.96,3.29 L 15.13,5.12 L 18.88,8.87 L 20.71,7.04 Z" Fill="#FFFFFF" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Edit Task"
                                   FontFamily="{DynamicResource AppTitleFontFamily}"
                                   FontSize="{DynamicResource AppTitleFontSize}"
                                   FontWeight="{DynamicResource AppTitleFontWeight}"
                                   Foreground="{DynamicResource AppTitleBarForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Style="{DynamicResource TitleBarCloseButtonStyle}"
                            Click="OnCancelClick" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Viewbox Width="10" Height="10" Visibility="{DynamicResource ModernOnlyVis}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 5,5 L 19,19 M 19,5 L 5,19"
                                          Stroke="{DynamicResource AppTitleBarForeground}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{DynamicResource Win95OnlyVis}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- Title Field -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="TASK TITLE" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtTitle" Height="30" FontSize="12"
                                     Style="{DynamicResource AppTextBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Date Field -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="TARGET DATE" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="DpTaskDate" Grid.Column="0" Height="28"
                                            FontFamily="{DynamicResource AppBaseFontFamily}" FontSize="11"
                                            VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="TODAY" Style="{DynamicResource SecondaryActionBtn}"
                                        Margin="8,0,0,0" Height="28" Padding="10,0" Click="OnDateTodayClick" />
                                <Button Grid.Column="2" Content="TOMORROW" Style="{DynamicResource SecondaryActionBtn}"
                                        Margin="6,0,0,0" Height="28" Padding="10,0" Click="OnDateTomorrowClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Details Field -->
                    <Border Style="{DynamicResource AppGroupBoxStyle}">
                        <StackPanel>
                            <TextBlock Text="DETAILS (OPTIONAL)" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AppPrimaryColor}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtDetails" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="80" VerticalScrollBarVisibility="Auto"
                                     Style="{DynamicResource AppTextBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Priority Option -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,6">
                        <CheckBox x:Name="ChkHighPriority" VerticalAlignment="Center" Cursor="Hand" />
                        <TextBlock Text="Mark as high priority" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppPrimaryColor}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnPriorityLabelClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Action Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Style="{DynamicResource SecondaryActionBtn}"
                            Margin="0,0,8,0" Padding="14,6" Click="OnCancelClick" />
                    <Button Content="SAVE CHANGES" Style="{DynamicResource PrimaryActionBtn}"
                            Padding="18,6" Click="OnSaveClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
