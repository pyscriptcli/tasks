                        <!-- Ghost Body with Flowing Wavy Sheet Hem -->
                        <Path Data="M 19,4 C 10,4 3,12 3,24 C 3,36 8,42 12,44 C 15,46 17,41 20,44 C 23,47 26,42 29,44 C 32,46 35,36 35,24 C 35,12 28,4 19,4 Z">
