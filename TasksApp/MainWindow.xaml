                            <Path Data="M 18,12 C 14,3 7,1 2,5 C 3,11 8,15 13,15 C 15,18 18,16 18,12 Z" Fill="#140620" Stroke="#FFA000" StrokeThickness="0.6" />
                            <Path Data="M 18,12 C 22,3 29,1 34,5 C 33,11 28,15 23,15 C 21,18 18,16 18,12 Z" Fill="#140620" Stroke="#FFA000" StrokeThickness="0.6" />
                            <Ellipse Width="7" Height="10" Fill="#090110" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- Rappelling Bungee Spiders Flanking the Dialog -->
                    <!-- Left Bungee Spider -->
                    <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="280" Margin="-60,-40,0,0">
                        <Line x:Name="RemSpiderLThread" X1="25" Y1="0" X2="25" Y2="20" Stroke="#B3FFFFFF" StrokeThickness="1.2" StrokeDashArray="3,2" />
                        <Grid Canvas.Left="12" Canvas.Top="15" Width="26" Height="26">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="RemSpiderLTranslate" Y="0" />
                            </Grid.RenderTransform>
                            <Path Data="M 13,10 C 6,4 2,8 0,15 M 13,12 C 4,10 0,14 1,21 M 13,14 C 5,16 2,21 3,25 M 13,10 C 20,4 24,8 26,15 M 13,12 C 22,10 26,14 25,21 M 13,14 C 21,16 24,21 23,25"
