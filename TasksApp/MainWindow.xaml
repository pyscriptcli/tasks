                        <!-- Upside-down Roosting Bat Suspended by Claws -->
                        <Grid Canvas.Left="84" Canvas.Top="4" Width="28" Height="36" RenderTransformOrigin="0.5,0.0">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="RoostingBatRotate" Angle="0" />
