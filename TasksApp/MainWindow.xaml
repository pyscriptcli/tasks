                                <Ellipse Width="5" Height="6.5" Fill="#212121" Margin="0,20,16,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                <Ellipse Width="2" Height="2" Fill="#FFFFFF" Margin="0,21,17,0" HorizontalAlignment="Right" VerticalAlignment="Top" />

