                            <Path Data="M 13,10 C 6,4 2,8 0,15 M 13,12 C 4,10 0,14 1,21 M 13,14 C 5,16 2,21 3,25 M 13,10 C 20,4 24,8 26,15 M 13,12 C 22,10 26,14 25,21 M 13,14 C 21,16 24,21 23,25"
                                  Stroke="#FF6B00" StrokeThickness="1.2" />
                            <Ellipse Width="11" Height="13" Fill="#140620" Stroke="#FFA000" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                                <Ellipse Width="2" Height="2" Fill="#FF2200" Margin="0,0,1,0" />
                                <Ellipse Width="2" Height="2" Fill="#FFFF00" />
                            </StackPanel>
                        </Grid>
                    </Canvas>

                    <!-- Cheering Ghostling Peeking on Left Pumpkin Shoulder -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-25,18,0,0" Width="44" Height="54" RenderTransformOrigin="0.5,0.8">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="RemGhostLeftTranslate" Y="0" />
                                <RotateTransform x:Name="RemGhostLeftRotate" Angle="0" />
