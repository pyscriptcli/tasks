                                <RotateTransform x:Name="Pumpkin1Rotate" Angle="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <!-- Curly Wiggling Green Stem -->
                        <Path Data="M 22,12 C 20,6 23,2 26,1 C 28,0 29,3 27,6 C 25,9 26,12 26,12 Z" Fill="#388E3C" RenderTransformOrigin="0.5,1.0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="Pumpkin1StemRotate" Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                        <!-- Pumpkin Body with Shaded Ribs -->
                        <Path Data="M 12,12 C 4,13 0,20 0,27 C 0,35 6,40 14,41 C 18,42 26,42 30,41 C 38,40 44,35 44,27 C 44,20 40,13 32,12 C 28,11 16,11 12,12 Z">
                            <Path.Fill>
                                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.6" RadiusY="0.6">
                                    <GradientStop Color="#FFB300" Offset="0.0" />
                                    <GradientStop Color="#FF6D00" Offset="0.55" />
                                    <GradientStop Color="#E65100" Offset="0.9" />
                                    <GradientStop Color="#BF360C" Offset="1.0" />
                                </RadialGradientBrush>
                            </Path.Fill>
                        </Path>
                        <!-- Pumpkin Vertical Rib Ridges -->
                        <Path Data="M 22,12 C 20,22 20,32 22,41 M 14,13 C 9,21 9,33 15,40 M 30,13 C 35,21 35,33 29,40"
                              Stroke="#C43C00" StrokeThickness="1.2" Opacity="0.5" />
                        <!-- Carved Glowing Triangular Eyes -->
                        <Polygon Points="13,23 18,17 17,24" Fill="#FFFF55" />
                        <Polygon Points="31,23 26,17 27,24" Fill="#FFFF55" />
                        <!-- Carved Jagged Smiling Mouth -->
                        <Path Data="M 10,29 Q 22,38 34,29 L 32,32 L 28,29 L 24,33 L 20,29 L 16,33 L 12,29 Z" Fill="#FFFF44" />
                        <Grid.Effect>
                            <DropShadowEffect x:Name="Pumpkin1Glow" Color="#FF7A00" BlurRadius="14" ShadowDepth="0" Opacity="0.85" />
                        </Grid.Effect>
                    </Grid>
                </Grid>

                <!-- ======================================================== -->
                <!-- CHRISTMAS AMBIENT LAYER (Santa's Cozy Hearth & Workshop)  -->
                <!-- Evergreen Garland, Twinkling Fairy Lights, Stockings     -->
                <!-- ======================================================== -->
                <Grid x:Name="ChristmasAmbientGrid" Grid.RowSpan="4" IsHitTestVisible="False"
                      Visibility="{DynamicResource ChristmasOnlyVis}" Panel.ZIndex="0" ClipToBounds="True">

                    <!-- Top Evergreen Pine Garland Eave Silhouette -->
                    <Path HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="16" Stretch="Fill"
                          Data="M 0,0 L 1060,0 L 1060,5 C 1020,14 980,6 940,12 C 900,16 860,6 820,13 C 780,16 740,7 700,14 C 660,17 620,6 580,13 C 540,17 500,7 460,13 C 420,17 380,6 340,14 C 300,17 260,7 220,13 C 180,17 140,6 100,13 C 60,17 20,6 0,12 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0D3B12" Offset="0.0" />
                                <GradientStop Color="#1B5E20" Offset="0.6" />
                                <GradientStop Color="#2E7D32" Offset="1.0" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- Top Fairy Lights String Along Garland -->
                    <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="28">
                        <!-- Light 1 (Gold) -->
                        <Ellipse Canvas.Left="80" Canvas.Top="6" Width="6" Height="9" Fill="#FFD700">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="LightGlow1" Color="#FFD700" BlurRadius="12" ShadowDepth="0" Opacity="0.85" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Light 2 (Santa Red) -->
                        <Ellipse Canvas.Left="190" Canvas.Top="7" Width="6" Height="9" Fill="#FF1744">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="LightGlow2" Color="#FF1744" BlurRadius="12" ShadowDepth="0" Opacity="0.85" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Light 3 (Emerald Green) -->
                        <Ellipse Canvas.Left="310" Canvas.Top="5" Width="6" Height="9" Fill="#00E676">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="LightGlow3" Color="#00E676" BlurRadius="12" ShadowDepth="0" Opacity="0.85" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Light 4 (Gold) -->
                        <Ellipse Canvas.Left="430" Canvas.Top="7" Width="6" Height="9" Fill="#FFD700">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Light 5 (Red) -->
                        <Ellipse Canvas.Left="560" Canvas.Top="6" Width="6" Height="9" Fill="#FF1744">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF1744" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Light 6 (Emerald) -->
                        <Ellipse Canvas.Left="690" Canvas.Top="7" Width="6" Height="9" Fill="#00E676">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00E676" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Light 7 (Gold) -->
                        <Ellipse Canvas.Left="820" Canvas.Top="5" Width="6" Height="9" Fill="#FFD700">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Light 8 (Red) -->
                        <Ellipse Canvas.Left="950" Canvas.Top="7" Width="6" Height="9" Fill="#FF1744">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF1744" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>

                    <!-- Top-Left Hanging Christmas Stocking -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="36" Height="50" Margin="18,12,0,0" RenderTransformOrigin="0.5,0.1">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="HangingStocking1Rotate" Angle="0" />
                        </Grid.RenderTransform>
                        <!-- Stocking Red Body -->
                        <Path Data="M 12,12 L 12,30 C 12,38 8,42 16,46 C 24,50 32,46 30,38 C 28,32 24,32 24,28 L 24,12 Z"
                              Fill="#D32F2F" Stroke="#B71C1C" StrokeThickness="1" />
                        <!-- White Fur Cuff -->
                        <Border Width="20" Height="8" Background="#FFFDF8" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,8,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                        </Border>
                        <!-- Holly Berry Accent -->
                        <StackPanel Orientation="Horizontal" Margin="14,14,0,0">
                            <Ellipse Width="3" Height="3" Fill="#FF1744" />
                            <Ellipse Width="3" Height="3" Fill="#FF1744" Margin="-1,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Top-Right Hanging Christmas Stocking with Candy Cane -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="50" Margin="0,12,120,0" RenderTransformOrigin="0.5,0.1">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="HangingStocking2Rotate" Angle="0" />
                        </Grid.RenderTransform>
                        <!-- Candy Cane poking out -->
                        <Path Data="M 20,4 C 20,-4 30,-4 30,4 L 30,16" Stroke="#FF1744" StrokeThickness="3" Fill="Transparent" StrokeDashArray="2,1.5" />
                        <!-- Stocking Evergreen Body -->
                        <Path Data="M 12,12 L 12,30 C 12,38 8,42 16,46 C 24,50 32,46 30,38 C 28,32 24,32 24,12 Z"
                              Fill="#1B5E20" Stroke="#0D3B12" StrokeThickness="1" />
                        <!-- White Fur Cuff -->
                        <Border Width="20" Height="8" Background="#FFFDF8" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,8,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFFFF" BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                        </Border>
                        <!-- Gold Star Accent -->
                        <TextBlock Text="⭐" FontSize="8" Margin="14,14,0,0" />
                    </Grid>
                </Grid>

                <!-- 1. Custom Title Bar (UR-040, UR-041, UR-070) -->
                <Border Grid.Row="0" Height="{DynamicResource AppTitleBarHeight}"
                        Background="{DynamicResource AppTitleBarBackground}"
                        BorderBrush="{DynamicResource AppTitleBarBorder}" BorderThickness="0,0,0,1" Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon (SVG Flat Yellow Sticky Note) & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- SVG Sticky Note Vector Icon -->
                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <!-- Note Surface -->
                                <Path Data="M 3,3 L 21,3 L 21,15 L 15,21 L 3,21 Z" Fill="#FFBF00" />
                                <!-- Folded Corner -->
                                <Path Data="M 15,15 L 21,15 L 15,21 Z" Fill="#E0A800" />
                                <!-- Crisp Note Lines -->
                                <Path Data="M 6,7.5 L 18,7.5 M 6,11.5 L 18,11.5 M 6,15.5 L 12,15.5"
                                      Stroke="#000000" StrokeThickness="1.5"
                                      StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Tasks" Foreground="{DynamicResource AppTitleBarForeground}"
                                   FontSize="{DynamicResource AppTitleFontSize}"
                                   FontWeight="{DynamicResource AppTitleFontWeight}"
                                   FontFamily="{DynamicResource AppTitleFontFamily}" VerticalAlignment="Center" />
                        <TextBlock Text=" 🎃 🕸️ 🦇" FontSize="14" Foreground="#FFFDF8" VerticalAlignment="Center"
                                   Visibility="{DynamicResource HalloweenOnlyVis}" Margin="6,0,0,0" ToolTip="Halloween Jack-o'-Lantern Theme" />
                        <TextBlock Text=" 🎄 ❄️ ⛄ 🎅" FontSize="14" Foreground="#FFFDF8" VerticalAlignment="Center"
                                   Visibility="{DynamicResource ChristmasOnlyVis}" Margin="6,0,0,0" ToolTip="Christmas (Santa's Workshop) Theme" />
                    </StackPanel>

                    <!-- Draggable Caption Area (UR-041) -->
                    <Border Grid.Column="1" Background="Transparent" />

                    <!-- Top Action Icons (Reminders Bell & Settings) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Update Available Alert Pill (opens Settings to update) -->
                        <Button ToolTip="New update available! Click to view and install update in Settings"
                                Height="26" Margin="0,0,8,0" Padding="8,2"
                                Background="#C9A84C" BorderThickness="0" Cursor="Hand"
                                Command="{Binding OpenSettingsCommand}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="11" Height="11" Margin="0,0,5,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 L 12,16 M 6,10 L 12,16 L 18,10 M 4,20 L 20,20"
                                              Stroke="#003366" StrokeThickness="2.4" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="UPDATE READY" FontSize="10" FontWeight="Bold" Foreground="#003366"
                                           FontFamily="{DynamicResource AppBaseFontFamily}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Notification Bell SVG Button (Task Reminders) -->
                        <Button ToolTip="Task Reminders (View today's tasks)"
                                Style="{DynamicResource TitleBarActionButtonStyle}"
                                Command="{Binding ShowReminderCommand}">
                            <Grid>
                                <!-- SVG Bell Icon -->
                                <Viewbox Width="12" Height="12">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,22 C 13.1,22 14,21.1 14,20 L 10,20 C 10,21.1 10.9,22 12,22 Z M 18,16 L 18,11 C 18,7.93 16.36,5.36 13.5,4.68 L 13.5,4 C 13.5,3.17 12.83,2.5 12,2.5 C 11.17,2.5 10.5,3.17 10.5,4 L 10.5,4.68 C 7.63,5.36 6,7.92 6,11 L 6,16 L 4,18 L 4,19 L 20,19 L 20,18 Z"
                                              Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Canvas>
                                </Viewbox>
                                <!-- Active Notification Dot Indicator (When there are pending tasks today) -->
                                <Border Background="{DynamicResource AppAccentColor}" Width="5" Height="5" CornerRadius="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                        Visibility="{Binding HasPendingTasksToday, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>

                        <!-- Settings SVG Button -->
                        <Button ToolTip="Preferences &amp; Reminders"
                                Style="{DynamicResource TitleBarActionButtonStyle}"
                                Command="{Binding OpenSettingsCommand}">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,15 C 10.34,15 9,13.66 9,12 C 9,10.34 10.34,9 12,9 C 13.66,9 15,10.34 15,12 C 15,13.66 13.66,15 12,15 Z M 19.4,13 C 19.45,12.67 19.5,12.34 19.5,12 C 19.5,11.66 19.45,11.33 19.4,11 L 21.54,9.33 C 21.73,9.18 21.79,8.91 21.66,8.69 L 19.66,5.23 C 19.53,5.01 19.27,4.92 19.04,5.01 L 16.52,6.02 C 16,5.62 15.43,5.29 14.81,5.04 L 14.43,2.36 C 14.39,2.11 14.18,1.93 13.93,1.93 L 10.07,1.93 C 9.82,1.93 9.61,2.11 9.57,2.36 L 9.19,5.04 C 8.57,5.29 8,5.63 7.48,6.02 L 4.96,5.01 C 4.73,4.92 4.47,5.01 4.34,5.23 L 2.34,8.69 C 2.21,8.91 2.27,9.18 2.46,9.33 L 4.6,11 C 4.55,11.33 4.5,11.67 4.5,12 C 4.5,12.33 4.55,12.67 4.6,13 L 2.46,14.67 C 2.27,14.82 2.21,15.09 2.34,15.31 L 4.34,18.77 C 4.47,18.99 4.73,19.08 4.96,18.99 L 7.48,17.98 C 8,18.38 8.57,18.71 9.19,18.96 L 9.57,21.64 C 9.61,21.89 9.82,22.07 10.07,22.07 L 13.93,22.07 C 14.18,22.07 14.39,21.89 14.43,21.64 L 14.81,18.96 C 15.43,18.71 16,18.37 16.52,17.98 L 19.04,18.99 C 19.27,19.08 19.53,18.99 19.66,18.77 L 21.66,15.31 C 21.79,15.09 21.73,14.82 21.54,14.67 L 19.4,13 Z"
                                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Standard Window Buttons: Min, Max, Close -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button Style="{DynamicResource TitleBarButtonStyle}" Click="OnMinimizeClick" ToolTip="Minimize">
                            <Grid>
                                <Viewbox Width="12" Height="12" Visibility="{DynamicResource ModernOnlyVis}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 3,13 L 21,13"
                                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="_" FontSize="11" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Bottom" Margin="0,0,0,3" HorizontalAlignment="Center" Visibility="{DynamicResource Win95OnlyVis}" />
                            </Grid>
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="BtnMaximize" Style="{DynamicResource TitleBarButtonStyle}" Click="OnMaximizeClick" ToolTip="Maximize">
                            <Grid>
                                <Viewbox Width="12" Height="12" Visibility="{DynamicResource ModernOnlyVis}">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="PathMaximize" Data="M 4,4 L 20,4 L 20,20 L 4,20 Z"
                                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" Fill="Transparent" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="TxtWin95Maximize" Text="□" FontSize="11" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{DynamicResource Win95OnlyVis}" />
                            </Grid>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{DynamicResource TitleBarCloseButtonStyle}" Click="OnCloseClick" ToolTip="Close (Runs in background)">
                            <Grid>
                                <Viewbox Width="12" Height="12" Visibility="{DynamicResource ModernOnlyVis}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 5,5 L 19,19 M 19,5 L 5,19"
                                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{DynamicResource Win95OnlyVis}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Date Navigation & Actions Bar (UR-008, UR-009) -->
            <Border Grid.Row="1" Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Day Navigation Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Previous Day SVG Chevron -->
                        <Button Style="{DynamicResource SecondaryActionBtn}" Command="{Binding PreviousDayCommand}"
                                ToolTip="Previous Day" Margin="0,0,6,0" Padding="8,6">
                            <Viewbox Width="10" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 16,4 L 8,12 L 16,20" Stroke="{DynamicResource AppToolbarForeground}" StrokeThickness="3"
                                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Next Day SVG Chevron -->
                        <Button Style="{DynamicResource SecondaryActionBtn}" Command="{Binding NextDayCommand}"
                                ToolTip="Next Day" Margin="0,0,8,0" Padding="8,6">
                            <Viewbox Width="10" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 8,4 L 16,12 L 8,20" Stroke="{DynamicResource AppToolbarForeground}" StrokeThickness="3"
                                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Jump to Today Button -->
                        <Button Style="{DynamicResource SecondaryActionBtn}" Command="{Binding JumpToTodayCommand}"
                                Margin="0,0,14,0" Padding="12,6">
                            <TextBlock Text="TODAY" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppToolbarForeground}"
                                       FontFamily="{DynamicResource AppBaseFontFamily}" />
                        </Button>

                        <!-- Active Date Title -->
                        <TextBlock Text="{Binding DisplayDateString}" FontSize="21" FontWeight="SemiBold" FontStyle="{DynamicResource AppDisplayFontStyle}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   Foreground="{DynamicResource AppToolbarForeground}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.5" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Date Picker Helper (UR-008: pick any day) -->
                        <DatePicker SelectedDate="{Binding CurrentDate, Mode=TwoWay}"
                                    VerticalAlignment="Center" Height="32" Width="130" Margin="4,0,0,0"
                                    FontFamily="{DynamicResource AppBaseFontFamily}" FontSize="11"
                                    BorderThickness="1" BorderBrush="{DynamicResource AppPanelBorder}"
                                    Background="{DynamicResource AppCardBackground}" Foreground="{DynamicResource AppTextForeground}"
                                    Cursor="Hand" ToolTip="Select any date from calendar (UR-008)" />
                    </StackPanel>

                    <!-- Task Statistics Chips & Add Task Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pending Chip -->
                        <Border Style="{DynamicResource AppSunkenBorderStyle}" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 12.5,7 L 11,7 L 11,13 L 16.2,16.2 L 17,14.9 L 12.5,12.2 Z"
                                              Fill="{DynamicResource AppPrimaryColor}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="PENDING " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PendingCount}" FontSize="15" FontFamily="{DynamicResource AppMetricFontFamily}"
                                           Foreground="{DynamicResource AppPrimaryColor}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Done Chip -->
                        <Border Style="{DynamicResource AppSunkenBorderStyle}" Padding="8,3" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 10,16.4 L 5.6,12 L 7,10.6 L 10,13.6 L 17,6.6 L 18.4,8 Z"
                                              Fill="#2E7D32" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="DONE " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CompletedCount}" FontSize="15" FontFamily="{DynamicResource AppMetricFontFamily}"
                                           Foreground="#2E7D32" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Add Task Button (SVG Plus + UI Caps) -->
                        <Button Style="{DynamicResource PrimaryActionBtn}" Command="{Binding AddTaskCommand}"
                                Height="36" Padding="16,0" Cursor="Hand" ToolTip="Add a new task for this day (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,4 L 12,20 M 4,12 L 20,12"
                                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="ADD TASK" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource AppBaseFontFamily}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main 2-Pane Content Workspace (Tasks on Left, Daily Notes on Right) -->
            <Grid Grid.Row="2" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="340" /> <!-- Tasks List -->
                    <ColumnDefinition Width="16" />                 <!-- Spacer -->
                    <ColumnDefinition Width="2*" MinWidth="260" /> <!-- Daily Notes -->
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Today's Tasks List (UR-004 to UR-007) -->
                <Border Grid.Column="0" Style="{DynamicResource AppSunkenBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane Header -->
                        <Border Grid.Row="0" Background="{DynamicResource AppCardBackground}"
                                BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TasksPaneTitle}" FontSize="11" FontWeight="Medium"
                                           FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                                <TextBlock Grid.Column="1" Text="Drag items to reorder" FontSize="11" Foreground="{DynamicResource AppMutedForeground}" />
                            </Grid>
                        </Border>

                        <!-- Empty State when no tasks exist -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVis}}" Margin="24">
                            <!-- SVG Checklist Illustration -->
                            <Viewbox Width="44" Height="44" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 19,3 L 14.82,3 C 14.4,1.84 13.3,1 12,1 C 10.7,1 9.6,1.84 9.18,3 L 5,3 C 3.9,3 3,3.9 3,5 L 3,19 C 3,20.1 3.9,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,5 C 21,3.9 20.1,3 19,3 Z M 12,3 C 12.55,3 13,3.45 13,4 C 13,4.55 12.55,5 12,5 C 11.45,5 11,4.55 11,4 C 11,3.45 11.45,3 12,3 Z M 18,17 L 6,17 M 18,13 L 6,13 M 18,9 L 6,9"
                                          Fill="#C5CBD3" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="No tasks scheduled for this day" FontSize="15" FontWeight="Normal"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" HorizontalAlignment="Center" />
                            <TextBlock Text="Click below to add your first task" FontSize="12" Foreground="{DynamicResource AppMutedForeground}" Margin="0,4,0,12" HorizontalAlignment="Center" />
                            <Button Content="+ ADD TASK" Style="{DynamicResource SecondaryActionBtn}"
                                    Command="{Binding AddTaskCommand}" Padding="18,8" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Task List with Drag & Drop Reordering (UR-007) -->
                        <ListBox x:Name="TasksListBox" Grid.Row="1"
                                 ItemsSource="{Binding Tasks}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="OnTaskListPreviewMouseDown"
                                 MouseMove="OnTaskListMouseMove"
                                 Drop="OnTaskListDrop"
                                 DragOver="OnTaskListDragOver"
                                 AllowDrop="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,1" />
                                    <Setter Property="Background" Value="{DynamicResource AppCardBackground}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /> <!-- SVG Drag Grip -->
                                                <ColumnDefinition Width="Auto" /> <!-- Priority Strip -->
                                                <ColumnDefinition Width="Auto" /> <!-- Checkbox (Done/Undo) -->
                                                <ColumnDefinition Width="*" />    <!-- Title & Details -->
                                                <ColumnDefinition Width="Auto" /> <!-- Actions (Badge, Edit, Delete) -->
                                            </Grid.ColumnDefinitions>

                                            <!-- SVG Drag Grip Dots (UR-007) -->
                                            <Viewbox Grid.Column="0" Width="12" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 9,6 A 1.5,1.5 0 1,1 9,3 A 1.5,1.5 0 1,1 9,6 Z M 9,13.5 A 1.5,1.5 0 1,1 9,10.5 A 1.5,1.5 0 1,1 9,13.5 Z M 9,21 A 1.5,1.5 0 1,1 9,18 A 1.5,1.5 0 1,1 9,21 Z M 15,6 A 1.5,1.5 0 1,1 15,3 A 1.5,1.5 0 1,1 15,6 Z M 15,13.5 A 1.5,1.5 0 1,1 15,10.5 A 1.5,1.5 0 1,1 15,13.5 Z M 15,21 A 1.5,1.5 0 1,1 15,18 A 1.5,1.5 0 1,1 15,21 Z"
                                                          Fill="#9AA5B1" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Priority Accent Strip (PRIME Gold for High Priority) (UR-003) -->
                                            <Border Grid.Column="1" Width="3" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                                                                <Setter Property="Background" Value="#C9A84C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Checkbox for Done / Undo (UR-006) -->
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>

                                            <!-- Title & Details Content (UR-001, UR-002) -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <!-- Title with Strikethrough Logic -->
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           FontFamily="{DynamicResource AppBaseFontFamily}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextForeground}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Optional Details -->
                                                <TextBlock Text="{Binding Details}" FontSize="11" TextWrapping="Wrap"
                                                           FontFamily="{DynamicResource AppBaseFontFamily}"
                                                           Foreground="{DynamicResource AppMutedForeground}" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Details}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#A0AAB5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Actions: High Priority Tag, SVG Edit, SVG Delete -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <!-- High Priority Badge (SVG Flag + Gold Tag) -->
                                                <Border Background="#FFF8E7" BorderBrush="#C9A84C" BorderThickness="1"
                                                        Padding="6,3" Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="10" Height="10" Margin="0,0,4,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M 14.4,6 L 14,4 L 5,4 L 5,21 L 7,21 L 7,14 L 12.6,14 L 13,16 L 20,16 L 20,6 Z"
                                                                      Fill="#C9A84C" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="HIGH" FontSize="9" FontWeight="Bold"
                                                                   FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Carried Over Badge -->
                                                <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppPrimaryColor}" BorderThickness="1"
                                                        Padding="6,3" Margin="0,0,8,0"
                                                        ToolTip="{Binding CarriedOverFrom, StringFormat='Carried over from {0}'}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCarriedOver}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="9" Height="9" Margin="0,0,4,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M 12,4 L 10.59,5.41 L 16.17,11 L 4,11 L 4,13 L 16.17,13 L 10.59,18.59 L 12,20 L 20,12 Z"
                                                                      Fill="{DynamicResource AppPrimaryColor}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="CARRIED OVER" FontSize="9" FontWeight="SemiBold"
                                                                   FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- SVG Edit Pencil Button (UR-004) -->
                                                <Button ToolTip="Edit Task" Width="28" Height="28" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" Margin="0,0,2,0"
                                                        Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="13" Height="13">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 3,17.25 L 3,21 L 6.75,21 L 17.81,9.94 L 14.06,6.19 Z M 20.71,7.04 C 21.1,6.65 21.1,6.02 20.71,5.63 L 18.37,3.29 C 17.98,2.9 17.35,2.9 16.96,3.29 L 15.13,5.12 L 18.88,8.87 Z"
                                                                  Fill="{DynamicResource AppPrimaryColor}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>

                                                <!-- SVG Delete Trash Can Button (UR-005) -->
                                                <Button ToolTip="Delete Task" Width="28" Height="28" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="13" Height="13">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 6,19 C 6,20.1 6.9,21 8,21 L 16,21 C 17.1,21 18,20.1 18,19 L 18,7 L 6,7 Z M 19,4 L 15.5,4 L 14.5,3 L 9.5,3 L 8.5,4 L 5,4 L 5,6 L 19,6 Z"
                                                                  Fill="#888888" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Christmas Falling Snowflakes Layer over Today's Tasks (Hit-test disabled so tasks interact normally) -->
                        <Canvas Grid.Row="1" IsHitTestVisible="False" Visibility="{DynamicResource ChristmasOnlyVis}" ClipToBounds="True">
                            <!-- Snowflake 1 -->
                            <TextBlock Text="❄" FontSize="16" Foreground="#90CAF9" Opacity="0.55" Canvas.Left="50" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="Snowflake1TranslateX" X="0" />
                                        <TranslateTransform x:Name="Snowflake1TranslateY" Y="-20" />
                                        <RotateTransform x:Name="Snowflake1Rotate" Angle="0" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Snowflake 2 -->
                            <TextBlock Text="❅" FontSize="20" Foreground="#E0F7FA" Opacity="0.6" Canvas.Left="160" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="Snowflake2TranslateX" X="0" />
                                        <TranslateTransform x:Name="Snowflake2TranslateY" Y="-20" />
                                        <RotateTransform x:Name="Snowflake2Rotate" Angle="0" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Snowflake 3 -->
                            <TextBlock Text="❄" FontSize="14" Foreground="#BBDEFB" Opacity="0.5" Canvas.Left="270" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="Snowflake3TranslateX" X="0" />
                                        <TranslateTransform x:Name="Snowflake3TranslateY" Y="-20" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Snowflake 4 -->
                            <TextBlock Text="✻" FontSize="18" Foreground="#E1F5FE" Opacity="0.65" Canvas.Left="380" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="Snowflake4TranslateX" X="0" />
                                        <TranslateTransform x:Name="Snowflake4TranslateY" Y="-20" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Right Pane: Daily Notes (UR-010, UR-011) -->
                <Border Grid.Column="2" Style="{DynamicResource AppSunkenBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane Header with SVG Document Icon and Saved Status -->
                        <Border Grid.Row="0" Background="{DynamicResource AppCardBackground}"
                                BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 14,2 L 6,2 C 4.9,2 4,2.9 4,4 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,8 Z M 13,3.5 L 18.5,9 L 13,9 Z"
                                                  Fill="{DynamicResource AppPrimaryColor}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="DAILY NOTES" FontSize="11" FontWeight="Medium"
                                               FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                                </StackPanel>

                                <!-- Confirmation Indicator (SVG Checkmark + Saved text) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotesSaveStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NotesSaveStatus}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Viewbox Width="10" Height="10" Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 4,12 L 9,17 L 20,6" Stroke="#2E7D32" StrokeThickness="3"
                                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding NotesSaveStatus}" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="#2E7D32" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Daily Notes Free Text Box (UR-010) -->
                        <TextBox Grid.Row="1" Text="{Binding DailyNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Padding="16" FontSize="13" Foreground="{DynamicResource AppTextForeground}"
                                 FontFamily="{DynamicResource AppBaseFontFamily}"
                                 Background="{DynamicResource AppCardBackground}" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" />

                        <!-- Christmas Falling Snowflakes Layer over Daily Notes (Hit-test disabled so typing works normally) -->
                        <Canvas Grid.Row="1" IsHitTestVisible="False" Visibility="{DynamicResource ChristmasOnlyVis}" ClipToBounds="True">
                            <!-- Snowflake Notes 1 -->
                            <TextBlock Text="❄" FontSize="18" Foreground="#90CAF9" Opacity="0.5" Canvas.Left="30" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="SnowflakeNotes1TranslateX" X="0" />
                                        <TranslateTransform x:Name="SnowflakeNotes1TranslateY" Y="-20" />
                                        <RotateTransform x:Name="SnowflakeNotes1Rotate" Angle="0" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Snowflake Notes 2 -->
                            <TextBlock Text="❅" FontSize="22" Foreground="#E0F7FA" Opacity="0.55" Canvas.Left="140" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="SnowflakeNotes2TranslateX" X="0" />
                                        <TranslateTransform x:Name="SnowflakeNotes2TranslateY" Y="-20" />
                                        <RotateTransform x:Name="SnowflakeNotes2Rotate" Angle="0" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>

                            <!-- Snowflake Notes 3 -->
                            <TextBlock Text="✻" FontSize="15" Foreground="#BBDEFB" Opacity="0.45" Canvas.Left="210" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="SnowflakeNotes3TranslateX" X="0" />
                                        <TranslateTransform x:Name="SnowflakeNotes3TranslateY" Y="-20" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>

                        <!-- Animated Vector Olaf the Snowman Companion Pet in Daily Notes (UR-Christmas, Hit-test disabled so typing is unaffected) -->
                        <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12"
                              Width="120" Height="150" IsHitTestVisible="False" Visibility="{DynamicResource ChristmasOnlyVis}">

                            <!-- Soft Snow Drift Base Olaf Perches Upon -->
                            <Path Data="M 10,140 Q 60,126 110,140 L 110,150 L 10,150 Z" Fill="#E3F2FD" Opacity="0.8" />

                            <!-- Olaf Snowman Structure -->
                            <!-- Lower Body / Belly Sphere with Squash & Stretch Wobble -->
                            <Grid Width="58" Height="50" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,88,0,0" RenderTransformOrigin="0.5,1.0">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="OlafBellyScaleX" ScaleX="1.0" />
                                        <ScaleTransform x:Name="OlafBellyScaleY" ScaleY="1.0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <!-- Belly Snowball -->
                                <Ellipse Width="58" Height="48" Fill="#FFFFFF" Stroke="#CFD8DC" StrokeThickness="1.5" />
                                <!-- Soft 3D Snow Shading -->
                                <Ellipse Width="52" Height="42" Fill="#F0F8FF" Opacity="0.6" Margin="0,4,0,0" />
                                <!-- 2 Coal Pebble Buttons on Belly -->
                                <Ellipse Width="7" Height="7" Fill="#263238" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" />
                                <Ellipse Width="7.5" Height="7.5" Fill="#212121" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0" />
                            </Grid>

                            <!-- Round Snowy Feet -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                <Ellipse Width="16" Height="12" Fill="#FFFFFF" Stroke="#CFD8DC" StrokeThickness="1.2" Margin="0,0,6,0" />
                                <Ellipse Width="16" Height="12" Fill="#FFFFFF" Stroke="#CFD8DC" StrokeThickness="1.2" />
                            </StackPanel>

                            <!-- Upper Chest Sphere -->
                            <Grid Width="42" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,62,0,0">
                                <Ellipse Width="42" Height="36" Fill="#FFFFFF" Stroke="#CFD8DC" StrokeThickness="1.5" />
                                <!-- 1 Coal Pebble Button on Chest -->
                                <Ellipse Width="6" Height="6" Fill="#263238" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Left Twig Stick Arm with Waving Animation -->
                            <Grid Width="42" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,62,0,0" RenderTransformOrigin="0.9,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="OlafArmLeftRotate" Angle="0" />
                                </Grid.RenderTransform>
                                <!-- Articulated Brown Twig with 3 Fingers -->
                                <Path Data="M 38,18 L 14,14 L 2,8 M 14,14 L 4,16 M 14,14 L 6,24"
                                      Stroke="#5D4037" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>

                            <!-- Right Twig Stick Arm with Waving Animation -->
                            <Grid Width="42" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,62,6,0" RenderTransformOrigin="0.1,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="OlafArmRightRotate" Angle="0" />
                                </Grid.RenderTransform>
                                <!-- Articulated Brown Twig with 3 Fingers -->
                                <Path Data="M 4,18 L 28,14 L 40,8 M 28,14 L 38,16 M 28,14 L 36,24"
                                      Stroke="#5D4037" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>

                            <!-- Olaf Head Container with Head Tilt, Carrot Sneeze, and Snowball Balance -->
                            <Grid Width="48" Height="60" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" RenderTransformOrigin="0.5,0.9">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="OlafHeadTranslate" Y="0" />
                                        <RotateTransform x:Name="OlafHeadRotate" Angle="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- Mini Snowball Balanced Atop Head (Balancing Wobble) -->
                                <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0" RenderTransformOrigin="0.5,1.0">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="OlafSnowballTranslate" X="0" />
                                            <RotateTransform x:Name="OlafSnowballRotate" Angle="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#90CAF9" StrokeThickness="1" />
                                    <TextBlock Text="✨" FontSize="7" Margin="2,1,0,0" />
                                </Grid>

                                <!-- 3 Stick Twig Hair Tufts Sprouting From Head -->
                                <Path Data="M 24,10 L 24,2 M 24,10 L 20,4 M 24,10 L 28,3"
                                      Stroke="#5D4037" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <!-- Olaf Sculpted Head Oval -->
                                <Path Data="M 24,8 C 12,8 8,20 10,34 C 12,46 16,54 24,54 C 32,54 36,46 38,34 C 40,20 36,8 24,8 Z"
                                      Fill="#FFFFFF" Stroke="#CFD8DC" StrokeThickness="1.5" />

