                            <Path Data="M 14,4 C 6,6 4,20 14,34 C 24,20 22,6 14,4 Z" Fill="#140620" Stroke="#FF6B00" StrokeThickness="0.8">
                                <Path.Effect>
                                    <DropShadowEffect Color="#FF6B00" BlurRadius="6" ShadowDepth="0" Opacity="0.5" />
                                </Path.Effect>
                            </Path>
                            <!-- Upside Down Ears & Glowing Eyes -->
                            <Polygon Points="9,34 7,39 12,36" Fill="#140620" />
                            <Polygon Points="19,34 21,39 16,36" Fill="#140620" />
                            <Ellipse Width="2.5" Height="2.5" Fill="#FFFF55" Margin="0,0,5,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            <Ellipse Width="2.5" Height="2.5" Fill="#FFFF55" Margin="5,0,0,6" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                    </Canvas>

                    <!-- Flying Vector Bat 1 (Swarming Across Titlebar with Flapping Wings) -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,10,0,0" Width="44" Height="26" RenderTransformOrigin="0.5,0.5">
