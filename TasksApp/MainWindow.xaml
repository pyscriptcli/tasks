                    </Grid>
                </Grid>

                <!-- 1b. Full-Screen Christmas Winter Wonderland Atmosphere (Visible only in Christmas Theme) -->
                <Grid Visibility="{DynamicResource ChristmasOnlyVis}" IsHitTestVisible="False">
                    <!-- Radiant Glowing North Star -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-150,0,0">
                        <TextBlock Text="⭐" FontSize="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="RemStarGlow" Color="#FFD700" BlurRadius="30" ShadowDepth="0" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Flying Reindeer Flight Swoop across sky -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-220,0,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="RemReindeerTranslate" X="0" />
                                <RotateTransform x:Name="RemReindeerRotate" Angle="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <!-- Reindeer Rudolph & Team with glowing nose -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
