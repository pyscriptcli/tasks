                        <Path Data="M 22,4 C 12,4 4,13 4,26 C 4,40 10,46 14,48 C 18,50 20,44 24,48 C 28,52 32,46 36,48 C 40,50 44,40 44,26 C 44,13 32,4 22,4 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
