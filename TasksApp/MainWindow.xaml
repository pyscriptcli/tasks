                    </Grid>

                    <!-- Cheerful Cartoon Bouncing Jack-o'-Lantern Mascot (Bottom-Right Margin) -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,38" Width="44" Height="42" RenderTransformOrigin="0.5,1.0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="Pumpkin1Translate" Y="0" />
