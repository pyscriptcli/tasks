                    <!-- Bottom-Left Corner Intricate Web with Climbing/Dangling Spider 2 -->
                    <Canvas HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="90" Height="90" Margin="0,0,0,0">
                        <Path Data="M 0,90 L 80,90 M 0,90 L 70,55 M 0,90 L 45,20 M 0,90 L 0,10
