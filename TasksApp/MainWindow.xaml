                                <Ellipse Width="2" Height="2" Fill="#FFFF00" />
                            </StackPanel>
                        </Grid>
                    </Canvas>

                    <!-- Right Bungee Spider -->
                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="50" Height="280" Margin="0,-40,-60,0">
                        <Line x:Name="RemSpiderRThread" X1="25" Y1="0" X2="25" Y2="20" Stroke="#B3FFFFFF" StrokeThickness="1.2" StrokeDashArray="3,2" />
                        <Grid Canvas.Left="12" Canvas.Top="15" Width="26" Height="26">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="RemSpiderRTranslate" Y="0" />
