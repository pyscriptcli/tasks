<Window x:Class="TasksApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tasks"
        Width="1060" Height="680"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackground}"
        FontFamily="{DynamicResource AppBaseFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Glowing Animation Storyboard for Reminder (UR-023) -->
        <Storyboard x:Key="ReminderGlowAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="BlurRadius"
                             From="10" To="32" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:1.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Outer Glowing Reminder Border (Normally invisible, pulses when reminder active) -->
        <Border x:Name="ReminderGlowBorder" BorderBrush="#C9A84C" BorderThickness="3"
                Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect" Color="#C9A84C" BlurRadius="20" ShadowDepth="0" Opacity="0.8" />
            </Border.Effect>
        </Border>

        <!-- Primary Layout Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />  <!-- Title Bar -->
                <RowDefinition Height="Auto" /> <!-- Date & Action Bar -->
                <RowDefinition Height="*" />    <!-- Main 2-Pane Content Area -->
                <RowDefinition Height="28" />  <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar (UR-040, UR-041, UR-070) -->
            <Border Grid.Row="0" Background="{DynamicResource AppTitleBarBackground}"
                    BorderBrush="{DynamicResource AppTitleBarBorder}" BorderThickness="0,0,0,1" Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon (SVG Flat Yellow Sticky Note) & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- SVG Sticky Note Vector Icon -->
                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <!-- Note Surface -->
                                <Path Data="M 3,3 L 21,3 L 21,15 L 15,21 L 3,21 Z" Fill="#FFBF00" />
                                <!-- Folded Corner -->
                                <Path Data="M 15,15 L 21,15 L 15,21 Z" Fill="#E0A800" />
                                <!-- Crisp Note Lines -->
                                <Path Data="M 6,7.5 L 18,7.5 M 6,11.5 L 18,11.5 M 6,15.5 L 12,15.5"
                                      Stroke="#000000" StrokeThickness="1.5"
                                      StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Tasks" Foreground="{DynamicResource AppTitleBarForeground}"
                                   FontSize="{DynamicResource AppTitleFontSize}"
                                   FontWeight="{DynamicResource AppTitleFontWeight}"
                                   FontFamily="{DynamicResource AppTitleFontFamily}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Draggable Caption Area (UR-041) -->
                    <Border Grid.Column="1" Background="Transparent" />

                    <!-- Top Action Icons (Reminders Bell & Settings) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Update Available Alert Pill (opens Settings to update) -->
                        <Button ToolTip="New update available! Click to view and install update in Settings"
                                Height="26" Margin="0,0,8,0" Padding="8,2"
                                Background="#C9A84C" BorderThickness="0" Cursor="Hand"
                                Command="{Binding OpenSettingsCommand}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="11" Height="11" Margin="0,0,5,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 L 12,16 M 6,10 L 12,16 L 18,10 M 4,20 L 20,20"
                                              Stroke="#003366" StrokeThickness="2.4" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="UPDATE READY" FontSize="10" FontWeight="Bold" Foreground="#003366"
                                           FontFamily="Montserrat, Segoe UI, sans-serif" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Notification Bell SVG Button (Task Reminders) -->
                        <Button ToolTip="Task Reminders (View today's tasks)" Width="36" Height="36" Margin="0,0,4,0"
                                Style="{DynamicResource TitleBarButtonStyle}"
                                Command="{Binding ShowReminderCommand}">
                            <Grid>
                                <!-- SVG Bell Icon -->
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,22 C 13.1,22 14,21.1 14,20 L 10,20 C 10,21.1 10.9,22 12,22 Z M 18,16 L 18,11 C 18,7.93 16.36,5.36 13.5,4.68 L 13.5,4 C 13.5,3.17 12.83,2.5 12,2.5 C 11.17,2.5 10.5,3.17 10.5,4 L 10.5,4.68 C 7.63,5.36 6,7.92 6,11 L 6,16 L 4,18 L 4,19 L 20,19 L 20,18 Z"
                                              Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Canvas>
                                </Viewbox>
                                <!-- Active Notification Dot Indicator (When there are pending tasks today) -->
                                <Border Background="{DynamicResource AppAccentColor}" Width="6" Height="6" CornerRadius="0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                        Visibility="{Binding HasPendingTasksToday, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>

                        <!-- Settings SVG Button -->
                        <Button ToolTip="Preferences &amp; Reminders" Width="36" Height="36"
                                Style="{DynamicResource TitleBarButtonStyle}"
                                Command="{Binding OpenSettingsCommand}">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,15 C 10.34,15 9,13.66 9,12 C 9,10.34 10.34,9 12,9 C 13.66,9 15,10.34 15,12 C 15,13.66 13.66,15 12,15 Z M 19.4,13 C 19.45,12.67 19.5,12.34 19.5,12 C 19.5,11.66 19.45,11.33 19.4,11 L 21.54,9.33 C 21.73,9.18 21.79,8.91 21.66,8.69 L 19.66,5.23 C 19.53,5.01 19.27,4.92 19.04,5.01 L 16.52,6.02 C 16,5.62 15.43,5.29 14.81,5.04 L 14.43,2.36 C 14.39,2.11 14.18,1.93 13.93,1.93 L 10.07,1.93 C 9.82,1.93 9.61,2.11 9.57,2.36 L 9.19,5.04 C 8.57,5.29 8,5.63 7.48,6.02 L 4.96,5.01 C 4.73,4.92 4.47,5.01 4.34,5.23 L 2.34,8.69 C 2.21,8.91 2.27,9.18 2.46,9.33 L 4.6,11 C 4.55,11.33 4.5,11.67 4.5,12 C 4.5,12.33 4.55,12.67 4.6,13 L 2.46,14.67 C 2.27,14.82 2.21,15.09 2.34,15.31 L 4.34,18.77 C 4.47,18.99 4.73,19.08 4.96,18.99 L 7.48,17.98 C 8,18.38 8.57,18.71 9.19,18.96 L 9.57,21.64 C 9.61,21.89 9.82,22.07 10.07,22.07 L 13.93,22.07 C 14.18,22.07 14.39,21.89 14.43,21.64 L 14.81,18.96 C 15.43,18.71 16,18.37 16.52,17.98 L 19.04,18.99 C 19.27,19.08 19.53,18.99 19.66,18.77 L 21.66,15.31 C 21.79,15.09 21.73,14.82 21.54,14.67 L 19.4,13 Z"
                                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Standard Window Buttons: Min, Max, Close (SVG Vectors) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize SVG -->
                        <Button Style="{DynamicResource TitleBarButtonStyle}" Click="OnMinimizeClick" ToolTip="Minimize">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 3,13 L 21,13"
                                          Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Maximize / Restore SVG -->
                        <Button x:Name="BtnMaximize" Style="{DynamicResource TitleBarButtonStyle}" Click="OnMaximizeClick" ToolTip="Maximize">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="PathMaximize" Data="M 4,4 L 20,4 L 20,20 L 4,20 Z"
                                          Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Close SVG -->
                        <Button Style="{DynamicResource TitleBarCloseButtonStyle}" Click="OnCloseClick" ToolTip="Close (Runs in background)">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 5,5 L 19,19 M 19,5 L 5,19"
                                          Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Date Navigation & Actions Bar (UR-008, UR-009) -->
            <Border Grid.Row="1" Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Day Navigation Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Previous Day SVG Chevron -->
                        <Button Style="{DynamicResource SecondaryActionBtn}" Command="{Binding PreviousDayCommand}"
                                ToolTip="Previous Day" Margin="0,0,6,0" Padding="8,6">
                            <Viewbox Width="10" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 16,4 L 8,12 L 16,20" Stroke="{DynamicResource AppTextForeground}" StrokeThickness="3"
                                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Next Day SVG Chevron -->
                        <Button Style="{DynamicResource SecondaryActionBtn}" Command="{Binding NextDayCommand}"
                                ToolTip="Next Day" Margin="0,0,8,0" Padding="8,6">
                            <Viewbox Width="10" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 8,4 L 16,12 L 8,20" Stroke="{DynamicResource AppTextForeground}" StrokeThickness="3"
                                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Jump to Today Button -->
                        <Button Style="{DynamicResource SecondaryActionBtn}" Command="{Binding JumpToTodayCommand}"
                                Margin="0,0,14,0" Padding="12,6">
                            <TextBlock Text="TODAY" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource AppBaseFontFamily}" />
                        </Button>

                        <!-- Active Date Title -->
                        <TextBlock Text="{Binding DisplayDateString}" FontSize="21" FontWeight="Normal" FontStyle="{DynamicResource AppDisplayFontStyle}"
                                   FontFamily="{DynamicResource AppDisplayFontFamily}"
                                   Foreground="{DynamicResource AppTextForeground}" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Date Picker Helper (UR-008: pick any day) -->
                        <DatePicker SelectedDate="{Binding CurrentDate, Mode=TwoWay}"
                                    VerticalAlignment="Center" Height="32" Width="130" Margin="4,0,0,0"
                                    FontFamily="{DynamicResource AppBaseFontFamily}" FontSize="11"
                                    BorderThickness="1" BorderBrush="{DynamicResource AppPanelBorder}"
                                    Background="{DynamicResource AppSurfaceBackground}"
                                    Cursor="Hand" ToolTip="Select any date from calendar (UR-008)" />
                    </StackPanel>

                    <!-- Task Statistics Chips & Add Task Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pending Chip -->
                        <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="1" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 12.5,7 L 11,7 L 11,13 L 16.2,16.2 L 17,14.9 L 12.5,12.2 Z"
                                              Fill="{DynamicResource AppPrimaryColor}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="PENDING " FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PendingCount}" FontSize="16" FontFamily="{DynamicResource AppMetricFontFamily}"
                                           Foreground="{DynamicResource AppPrimaryColor}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Done Chip -->
                        <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="1" Padding="10,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 10,16.4 L 5.6,12 L 7,10.6 L 10,13.6 L 17,6.6 L 18.4,8 Z"
                                              Fill="#2E7D32" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="DONE " FontSize="10" FontWeight="Medium" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CompletedCount}" FontSize="16" FontFamily="{DynamicResource AppMetricFontFamily}"
                                           Foreground="#2E7D32" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Add Task Button (SVG Plus + UI Caps) -->
                        <Button Style="{DynamicResource PrimaryActionBtn}" Command="{Binding AddTaskCommand}"
                                Height="36" Padding="16,0" Cursor="Hand" ToolTip="Add a new task for this day (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,8,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,4 L 12,20 M 4,12 L 20,12"
                                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="3"
                                              StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="ADD TASK" FontSize="11" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource AppBaseFontFamily}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main 2-Pane Content Workspace (Tasks on Left, Daily Notes on Right) -->
            <Grid Grid.Row="2" Margin="20,16,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="340" /> <!-- Tasks List -->
                    <ColumnDefinition Width="16" />                 <!-- Spacer -->
                    <ColumnDefinition Width="2*" MinWidth="260" /> <!-- Daily Notes -->
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Today's Tasks List (UR-004 to UR-007) -->
                <Border Grid.Column="0" Background="{DynamicResource AppPanelBackground}"
                        BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="{DynamicResource AppPanelBorderThickness}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane Header -->
                        <Border Grid.Row="0" Background="{DynamicResource AppPanelBackground}"
                                BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TasksPaneTitle}" FontSize="11" FontWeight="Medium"
                                           FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                                <TextBlock Grid.Column="1" Text="Drag items to reorder" FontSize="11" Foreground="{DynamicResource AppMutedForeground}" />
                            </Grid>
                        </Border>

                        <!-- Empty State when no tasks exist -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVis}}" Margin="24">
                            <!-- SVG Checklist Illustration -->
                            <Viewbox Width="44" Height="44" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 19,3 L 14.82,3 C 14.4,1.84 13.3,1 12,1 C 10.7,1 9.6,1.84 9.18,3 L 5,3 C 3.9,3 3,3.9 3,5 L 3,19 C 3,20.1 3.9,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,5 C 21,3.9 20.1,3 19,3 Z M 12,3 C 12.55,3 13,3.45 13,4 C 13,4.55 12.55,5 12,5 C 11.45,5 11,4.55 11,4 C 11,3.45 11.45,3 12,3 Z M 18,17 L 6,17 M 18,13 L 6,13 M 18,9 L 6,9"
                                          Fill="#C5CBD3" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="No tasks scheduled for this day" FontSize="15" FontWeight="Normal"
                                       FontFamily="{DynamicResource AppDisplayFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" HorizontalAlignment="Center" />
                            <TextBlock Text="Click below to add your first task" FontSize="12" Foreground="{DynamicResource AppMutedForeground}" Margin="0,4,0,12" HorizontalAlignment="Center" />
                            <Button Content="+ ADD TASK" Style="{DynamicResource SecondaryActionBtn}"
                                    Command="{Binding AddTaskCommand}" Padding="18,8" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Task List with Drag & Drop Reordering (UR-007) -->
                        <ListBox x:Name="TasksListBox" Grid.Row="1"
                                 ItemsSource="{Binding Tasks}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="OnTaskListPreviewMouseDown"
                                 MouseMove="OnTaskListMouseMove"
                                 Drop="OnTaskListDrop"
                                 DragOver="OnTaskListDragOver"
                                 AllowDrop="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,1" />
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#EEF2F6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /> <!-- SVG Drag Grip -->
                                                <ColumnDefinition Width="Auto" /> <!-- Priority Strip -->
                                                <ColumnDefinition Width="Auto" /> <!-- Checkbox (Done/Undo) -->
                                                <ColumnDefinition Width="*" />    <!-- Title & Details -->
                                                <ColumnDefinition Width="Auto" /> <!-- Actions (Badge, Edit, Delete) -->
                                            </Grid.ColumnDefinitions>

                                            <!-- SVG Drag Grip Dots (UR-007) -->
                                            <Viewbox Grid.Column="0" Width="12" Height="16" Margin="0,0,8,0"
                                                     VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M 9,6 A 1.5,1.5 0 1,1 9,3 A 1.5,1.5 0 1,1 9,6 Z M 9,13.5 A 1.5,1.5 0 1,1 9,10.5 A 1.5,1.5 0 1,1 9,13.5 Z M 9,21 A 1.5,1.5 0 1,1 9,18 A 1.5,1.5 0 1,1 9,21 Z M 15,6 A 1.5,1.5 0 1,1 15,3 A 1.5,1.5 0 1,1 15,6 Z M 15,13.5 A 1.5,1.5 0 1,1 15,10.5 A 1.5,1.5 0 1,1 15,13.5 Z M 15,21 A 1.5,1.5 0 1,1 15,18 A 1.5,1.5 0 1,1 15,21 Z"
                                                          Fill="#9AA5B1" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Priority Accent Strip (PRIME Gold for High Priority) (UR-003) -->
                                            <Border Grid.Column="1" Width="3" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                                                                <Setter Property="Background" Value="#C9A84C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Checkbox for Done / Undo (UR-006) -->
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>

                                            <!-- Title & Details Content (UR-001, UR-002) -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <!-- Title with Strikethrough Logic -->
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           FontFamily="Montserrat, Segoe UI, sans-serif"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0C0C0E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="#88929A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Optional Details -->
                                                <TextBlock Text="{Binding Details}" FontSize="11" TextWrapping="Wrap"
                                                           FontFamily="Montserrat, Segoe UI, sans-serif"
                                                           Foreground="#555555" Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Details}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#A0AAB5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Actions: High Priority Tag, SVG Edit, SVG Delete -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <!-- High Priority Badge (SVG Flag + Gold Tag) -->
                                                <Border Background="#FFF8E7" BorderBrush="#C9A84C" BorderThickness="1"
                                                        Padding="6,3" Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="10" Height="10" Margin="0,0,4,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M 14.4,6 L 14,4 L 5,4 L 5,21 L 7,21 L 7,14 L 12.6,14 L 13,16 L 20,16 L 20,6 Z"
                                                                      Fill="#C9A84C" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="HIGH" FontSize="9" FontWeight="Bold"
                                                                   FontFamily="Montserrat, Segoe UI, sans-serif" Foreground="#003366" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Carried Over Badge -->
                                                <Border Background="#F4F6F8" BorderBrush="#003366" BorderThickness="1"
                                                        Padding="6,3" Margin="0,0,8,0"
                                                        ToolTip="{Binding CarriedOverFrom, StringFormat='Carried over from {0}'}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCarriedOver}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Viewbox Width="9" Height="9" Margin="0,0,4,0">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M 12,4 L 10.59,5.41 L 16.17,11 L 4,11 L 4,13 L 16.17,13 L 10.59,18.59 L 12,20 L 20,12 Z"
                                                                      Fill="#003366" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="CARRIED OVER" FontSize="9" FontWeight="SemiBold"
                                                                   FontFamily="Montserrat, Segoe UI, sans-serif" Foreground="#003366" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- SVG Edit Pencil Button (UR-004) -->
                                                <Button ToolTip="Edit Task" Width="28" Height="28" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand" Margin="0,0,2,0"
                                                        Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="13" Height="13">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 3,17.25 L 3,21 L 6.75,21 L 17.81,9.94 L 14.06,6.19 Z M 20.71,7.04 C 21.1,6.65 21.1,6.02 20.71,5.63 L 18.37,3.29 C 17.98,2.9 17.35,2.9 16.96,3.29 L 15.13,5.12 L 18.88,8.87 Z"
                                                                  Fill="#003366" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>

                                                <!-- SVG Delete Trash Can Button (UR-005) -->
                                                <Button ToolTip="Delete Task" Width="28" Height="28" Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Viewbox Width="13" Height="13">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M 6,19 C 6,20.1 6.9,21 8,21 L 16,21 C 17.1,21 18,20.1 18,19 L 18,7 L 6,7 Z M 19,4 L 15.5,4 L 14.5,3 L 9.5,3 L 8.5,4 L 5,4 L 5,6 L 19,6 Z"
                                                                  Fill="#888888" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right Pane: Daily Notes (UR-010, UR-011) -->
                <Border Grid.Column="2" Background="{DynamicResource AppPanelBackground}"
                        BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="{DynamicResource AppPanelBorderThickness}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane Header with SVG Document Icon and Saved Status -->
                        <Border Grid.Row="0" Background="{DynamicResource AppPanelBackground}"
                                BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 14,2 L 6,2 C 4.9,2 4,2.9 4,4 L 4,20 C 4,21.1 4.9,22 6,22 L 18,22 C 19.1,22 20,21.1 20,20 L 20,8 Z M 13,3.5 L 18.5,9 L 13,9 Z"
                                                  Fill="{DynamicResource AppPrimaryColor}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="DAILY NOTES" FontSize="11" FontWeight="Medium"
                                               FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                                </StackPanel>

                                <!-- Confirmation Indicator (SVG Checkmark + Saved text) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NotesSaveStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NotesSaveStatus}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Viewbox Width="10" Height="10" Margin="0,0,4,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 4,12 L 9,17 L 20,6" Stroke="#2E7D32" StrokeThickness="3"
                                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding NotesSaveStatus}" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="#2E7D32" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Daily Notes Free Text Box (UR-010) -->
                        <TextBox Grid.Row="1" Text="{Binding DailyNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Padding="16" FontSize="13" Foreground="{DynamicResource AppTextForeground}"
                                 FontFamily="{DynamicResource AppBaseFontFamily}"
                                 Background="{DynamicResource AppCardBackground}" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,1,0,0" Padding="16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Storage: " FontSize="11" Foreground="#888888" />
                        <TextBlock Text="{Binding Settings.DataDirectory}" FontSize="11" Foreground="#555555" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Reminders: " FontSize="11" Foreground="#888888" />
                        <TextBlock Text="{Binding RemindersEnabled, Converter={x:Null}, StringFormat='Active'}" FontSize="11" FontWeight="SemiBold" Foreground="#003366">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Active" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RemindersEnabled}" Value="False">
                                            <Setter Property="Text" Value="Off" />
                                            <Setter Property="Foreground" Value="#888888" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- SKELETON PLACEHOLDER LOADING SCREEN (UR-060, UR-061) -->
        <!-- ======================================================== -->
        <Border Background="#FFFCFB" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Titlebar Skeleton -->
                <Border Grid.Row="0" Background="#003366" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,3 L 21,3 L 21,15 L 15,21 L 3,21 Z" Fill="#FFBF00" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Tasks" Foreground="#FFFCFB" FontSize="19"
                                   FontFamily="Cormorant Garamond, Georgia, serif" />
                    </StackPanel>
                </Border>

                <!-- Navigation Placeholder Bar -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DDE2E6" BorderThickness="0,0,0,1" Padding="20,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E6ECF2" Width="80" Height="28" Margin="0,0,12,0" />
                        <Border Background="#E6ECF2" Width="220" Height="28" />
                    </StackPanel>
                </Border>

                <!-- Main Workspace Skeleton Placeholders -->
                <Grid Grid.Row="2" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Skeleton -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DDE2E6" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <Border Background="#E6ECF2" Width="140" Height="16" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <Border Background="#F0F4F8" Height="44" Margin="0,0,0,10" />
                            <Border Background="#F0F4F8" Height="44" Margin="0,0,0,10" />
                            <Border Background="#F0F4F8" Height="44" Margin="0,0,0,10" />
                            <Border Background="#F0F4F8" Height="44" Margin="0,0,0,10" />
                        </StackPanel>
                    </Border>

                    <!-- Right Skeleton -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DDE2E6" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <Border Background="#E6ECF2" Width="120" Height="16" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <Border Background="#F0F4F8" Height="140" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Progress Bar with Percentage -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#DDE2E6" BorderThickness="0,1,0,0" Padding="24,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LoadingStatusText}" FontSize="12" Foreground="#003366" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding LoadingProgress, StringFormat='{}{0}%'}" FontSize="14"
                                       FontFamily="Bebas Neue, Impact, sans-serif" Foreground="#003366" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Height="4" Value="{Binding LoadingProgress}" Maximum="100"
                                     Foreground="#003366" Background="#E6ECF2" BorderThickness="0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- REMINDER OVERLAY DIALOG (UR-020, UR-021, UR-022, UR-024) -->
        <!-- ======================================================== -->
        <Border Background="#70000000" Visibility="{Binding IsReminderOverlayVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="200">
            <Border Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppTitleBarBackground}" BorderThickness="2" Width="660" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header with SVG Bell Alert -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource AppTitleBarBackground}" BorderThickness="0,0,0,2" Padding="0,0,0,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 12,22 C 13.1,22 14,21.1 14,20 L 10,20 C 10,21.1 10.9,22 12,22 Z M 18,16 L 18,11 C 18,7.93 16.36,5.36 13.5,4.68 L 13.5,4 C 13.5,3.17 12.83,2.5 12,2.5 C 11.17,2.5 10.5,3.17 10.5,4 L 10.5,4.68 C 7.63,5.36 6,7.92 6,11 L 6,16 L 4,18 L 4,19 L 20,19 L 20,18 Z"
                                                  Fill="{DynamicResource AppAccentColor}" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="TASK REMINDER" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppAccentColor}"
                                               FontFamily="{DynamicResource AppBaseFontFamily}" />
                                </StackPanel>
                                <TextBlock Text="Today's Tasks Summary" FontSize="24" FontWeight="Normal"
                                           FontFamily="{DynamicResource AppDisplayFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource AppPrimaryColor}" Padding="14,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ReminderPendingCount}" FontSize="16"
                                               FontFamily="{DynamicResource AppMetricFontFamily}" Foreground="{DynamicResource AppAccentForeground}" Margin="0,0,4,0" />
                                    <TextBlock Text="PENDING" FontSize="11" FontWeight="SemiBold"
                                               FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppTitleBarForeground}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Subhead Description -->
                    <TextBlock Grid.Row="1" Text="Here is the current status of all tasks scheduled for today:"
                               FontSize="13" Foreground="#181D1E" FontFamily="Montserrat, Segoe UI, sans-serif" Margin="0,0,0,12" />

                    <!-- Tasks List for Reminder (UR-021) -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDE2E6" BorderThickness="1" MaxHeight="260" Margin="0,0,0,18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReminderTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#EEF2F6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Status SVG Icon -->
                                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <!-- Done Check SVG -->
                                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 10,16.4 L 5.6,12 L 7,10.6 L 10,13.6 L 17,6.6 L 18.4,8 Z"
                                                              Fill="#2E7D32">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <!-- Pending Circle SVG -->
                                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z"
                                                              Fill="#003366">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                           FontFamily="Montserrat, Segoe UI, sans-serif" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="#0C0C0E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="#88929A" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Status Badge (PENDING or DONE) -->
                                                <Border Grid.Column="2" Padding="6,2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF8E7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold" FontFamily="Montserrat, Segoe UI, sans-serif">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="PENDING" />
                                                                <Setter Property="Foreground" Value="#003366" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Text" Value="DONE" />
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Actions: Dismiss & Snooze Options (UR-024) -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Snooze Presets with SVG Clock Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 12.5,7 L 11,7 L 11,13 L 16,16 L 16.8,14.8 L 12.5,12.2 Z"
                                          Fill="#555555" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="SNOOZE: " FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Montserrat, Segoe UI, sans-serif" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="10M" Style="{DynamicResource SecondaryActionBtn}" Margin="0,0,4,0" Padding="8,4"
                                    Command="{Binding SnoozeReminderCommand}" CommandParameter="10" />
                            <Button Content="30M" Style="{DynamicResource SecondaryActionBtn}" Margin="0,0,4,0" Padding="8,4"
                                    Command="{Binding SnoozeReminderCommand}" CommandParameter="30" />
                            <Button Content="1H" Style="{DynamicResource SecondaryActionBtn}" Padding="8,4"
                                    Command="{Binding SnoozeReminderCommand}" CommandParameter="60" />
                        </StackPanel>

                        <!-- Dismiss Button -->
                        <Button Grid.Column="2" Content="DISMISS" Style="{DynamicResource GoldActionBtn}"
                                Command="{Binding DismissReminderCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
