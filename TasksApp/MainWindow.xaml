                        </Grid.RenderTransform>
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BurstBat1Flap" ScaleY="1.0" />
                            </Grid.RenderTransform>
                            <Path Data="M 18,12 C 14,3 7,1 2,5 C 3,11 8,15 13,15 C 15,18 18,16 18,12 Z" Fill="#140620" Stroke="#FFA000" StrokeThickness="0.6" />
                            <Path Data="M 18,12 C 22,3 29,1 34,5 C 33,11 28,15 23,15 C 21,18 18,16 18,12 Z" Fill="#140620" Stroke="#FFA000" StrokeThickness="0.6" />
                            <Ellipse Width="7" Height="10" Fill="#090110" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="1.5" Height="1.5" Fill="#FFFF55" Margin="0,0,2.5,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="1.5" Height="1.5" Fill="#FFFF55" Margin="2.5,0,0,1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- Burst Bat 2: Top-Right -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="36" Height="22" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="BurstBat2Translate" X="0" Y="0" />
                                <ScaleTransform x:Name="BurstBat2Scale" ScaleX="0.8" ScaleY="0.8" />
