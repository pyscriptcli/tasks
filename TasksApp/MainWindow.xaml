<Window x:Class="TasksApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tasks"
        Width="1060" Height="680"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackground}"
        FontFamily="{DynamicResource AppBaseFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Glowing Animation Storyboard for Reminder (UR-023) -->
        <Storyboard x:Key="ReminderGlowAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="BlurRadius"
                             From="10" To="32" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="GlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:1.2" />
        </Storyboard>

        <!-- Halloween Ambient Continuous Floating Animations -->
        <Storyboard x:Key="HalloweenAmbientStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <!-- Bat 1: Gliding & fluttering across titlebar -->
            <DoubleAnimation Storyboard.TargetName="Bat1Translate" Storyboard.TargetProperty="X" From="0" To="48" Duration="0:0:3.2">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bat1Translate" Storyboard.TargetProperty="Y" From="0" To="-22" Duration="0:0:2.1">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bat1Rotate" Storyboard.TargetProperty="Angle" From="-14" To="14" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bat1WingScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.65" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- Bat 2: Swooping flutter in upper right margin -->
            <DoubleAnimation Storyboard.TargetName="Bat2Translate" Storyboard.TargetProperty="X" From="0" To="-42" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bat2Translate" Storyboard.TargetProperty="Y" From="0" To="20" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bat2WingScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.65" Duration="0:0:0.16" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- Roosting Bat: Hanging upside down, gentle pendulum sway -->
            <DoubleAnimation Storyboard.TargetName="RoostingBatRotate" Storyboard.TargetProperty="Angle" From="-10" To="10" Duration="0:0:2.5">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RoostingBatWingScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="0.75" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Ghost 1: Drifting floating up and down with eerie opacity breathing -->
            <DoubleAnimation Storyboard.TargetName="Ghost1Translate" Storyboard.TargetProperty="Y" From="0" To="-34" Duration="0:0:3.5">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Ghost1Translate" Storyboard.TargetProperty="X" From="0" To="24" Duration="0:0:4.0">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Ghost1Rotate" Storyboard.TargetProperty="Angle" From="-8" To="8" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Ghost1Effect" Storyboard.TargetProperty="Opacity" From="0.4" To="0.95" Duration="0:0:2.2" />

            <!-- Jack-o'-Lantern 1: Cartoon squash-and-stretch bouncing hop -->
            <DoubleAnimation Storyboard.TargetName="Pumpkin1Translate" Storyboard.TargetProperty="Y" From="0" To="-22" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Pumpkin1ScaleX" Storyboard.TargetProperty="ScaleX" From="1.15" To="0.9" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Pumpkin1ScaleY" Storyboard.TargetProperty="ScaleY" From="0.85" To="1.12" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Pumpkin1Rotate" Storyboard.TargetProperty="Angle" From="-10" To="10" Duration="0:0:2.2">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Pumpkin1StemRotate" Storyboard.TargetProperty="Angle" From="-15" To="15" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Pumpkin1Glow" Storyboard.TargetProperty="BlurRadius" From="8" To="28" Duration="0:0:0.8" />

            <!-- Spider 1: Dropping & climbing on web thread with stretching silk line -->
            <DoubleAnimation Storyboard.TargetName="Spider1Translate" Storyboard.TargetProperty="Y" From="0" To="44" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Spider1Rotate" Storyboard.TargetProperty="Angle" From="-14" To="14" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SilkThread1" Storyboard.TargetProperty="Y2" From="28" To="72" Duration="0:0:2.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Spider 2: Bottom corner climbing & dangling spider -->
            <DoubleAnimation Storyboard.TargetName="Spider2Translate" Storyboard.TargetProperty="Y" From="0" To="-36" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Spider2Rotate" Storyboard.TargetProperty="Angle" From="12" To="-12" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SilkThread2" Storyboard.TargetProperty="Y2" From="50" To="14" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Web Trapped Firefly / Embers Glow Pulsing -->
            <DoubleAnimation Storyboard.TargetName="WebEmber1Glow" Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:1.2" />
            <DoubleAnimation Storyboard.TargetName="WebEmber2Glow" Storyboard.TargetProperty="Opacity" From="0.2" To="0.9" Duration="0:0:1.5" />
        </Storyboard>

        <!-- Halloween Reminder Animated Takeover Storyboard (Grand Spectacle) -->
        <Storyboard x:Key="HalloweenReminderStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <!-- Midnight Harvest Moon Breathing Glow -->
            <DoubleAnimation Storyboard.TargetName="RemMoonGlow" Storyboard.TargetProperty="BlurRadius" From="24" To="60" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="RemMoonGlow" Storyboard.TargetProperty="Opacity" From="0.65" To="1.0" Duration="0:0:1.8" />

            <!-- Radial Bat Swarm Explosion -->
            <DoubleAnimation Storyboard.TargetName="BurstBat1Translate" Storyboard.TargetProperty="X" From="0" To="-280" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat1Translate" Storyboard.TargetProperty="Y" From="0" To="-190" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat1Scale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1.5" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="BurstBat1Scale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1.5" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="BurstBat1Flap" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.7" Duration="0:0:0.15" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="BurstBat2Translate" Storyboard.TargetProperty="X" From="0" To="280" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat2Translate" Storyboard.TargetProperty="Y" From="0" To="-190" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat2Scale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1.5" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="BurstBat2Scale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1.5" Duration="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="BurstBat2Flap" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.7" Duration="0:0:0.15" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="BurstBat3Translate" Storyboard.TargetProperty="X" From="0" To="-340" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat3Translate" Storyboard.TargetProperty="Y" From="0" To="20" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat3Scale" Storyboard.TargetProperty="ScaleX" From="0.5" To="1.4" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="BurstBat3Scale" Storyboard.TargetProperty="ScaleY" From="0.5" To="1.4" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="BurstBat3Flap" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.7" Duration="0:0:0.16" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="BurstBat4Translate" Storyboard.TargetProperty="X" From="0" To="340" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat4Translate" Storyboard.TargetProperty="Y" From="0" To="20" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat4Scale" Storyboard.TargetProperty="ScaleX" From="0.5" To="1.4" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="BurstBat4Scale" Storyboard.TargetProperty="ScaleY" From="0.5" To="1.4" Duration="0:0:1.8" />
            <DoubleAnimation Storyboard.TargetName="BurstBat4Flap" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.7" Duration="0:0:0.16" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="BurstBat5Translate" Storyboard.TargetProperty="X" From="0" To="-260" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat5Translate" Storyboard.TargetProperty="Y" From="0" To="210" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat5Scale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1.5" Duration="0:0:1.7" />
            <DoubleAnimation Storyboard.TargetName="BurstBat5Scale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1.5" Duration="0:0:1.7" />
            <DoubleAnimation Storyboard.TargetName="BurstBat5Flap" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.7" Duration="0:0:0.17" AutoReverse="True" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="BurstBat6Translate" Storyboard.TargetProperty="X" From="0" To="260" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat6Translate" Storyboard.TargetProperty="Y" From="0" To="210" Duration="0:0:1.7">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BurstBat6Scale" Storyboard.TargetProperty="ScaleX" From="0.7" To="1.5" Duration="0:0:1.7" />
            <DoubleAnimation Storyboard.TargetName="BurstBat6Scale" Storyboard.TargetProperty="ScaleY" From="0.7" To="1.5" Duration="0:0:1.7" />
            <DoubleAnimation Storyboard.TargetName="BurstBat6Flap" Storyboard.TargetProperty="ScaleY" From="1.0" To="-0.7" Duration="0:0:0.17" AutoReverse="True" RepeatBehavior="Forever" />

            <!-- Giant Mascot Jack-o'-Lantern Rocking, Bouncing & Carved Glowing Eyes -->
            <DoubleAnimation Storyboard.TargetName="RemPumpkinTranslate" Storyboard.TargetProperty="Y" From="0" To="-16" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemPumpkinScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.05" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemPumpkinScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.05" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemPumpkinRock" Storyboard.TargetProperty="Angle" From="-4" To="4" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="JackStemWiggle" Storyboard.TargetProperty="Angle" From="-14" To="14" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HalloweenBannerGlow" Storyboard.TargetProperty="BlurRadius" From="14" To="40" Duration="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="HalloweenBannerGlow" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.6" />
            <DoubleAnimation Storyboard.TargetName="JackLeftEyeGlow" Storyboard.TargetProperty="BlurRadius" From="12" To="34" Duration="0:0:0.65" />
            <DoubleAnimation Storyboard.TargetName="JackLeftEyeGlow" Storyboard.TargetProperty="Opacity" From="0.65" To="1.0" Duration="0:0:0.65" />
            <DoubleAnimation Storyboard.TargetName="JackRightEyeGlow" Storyboard.TargetProperty="BlurRadius" From="12" To="34" Duration="0:0:0.55" />
            <DoubleAnimation Storyboard.TargetName="JackRightEyeGlow" Storyboard.TargetProperty="Opacity" From="0.65" To="1.0" Duration="0:0:0.55" />
            <DoubleAnimation Storyboard.TargetName="JackMouthGlow" Storyboard.TargetProperty="BlurRadius" From="16" To="45" Duration="0:0:0.75" />
            <DoubleAnimation Storyboard.TargetName="JackMouthGlow" Storyboard.TargetProperty="Opacity" From="0.7" To="1.0" Duration="0:0:0.75" />
            <DoubleAnimation Storyboard.TargetName="JackMouthScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.3" Duration="0:0:0.6" />

            <!-- Pupil Eye Movement -->
            <DoubleAnimation Storyboard.TargetName="RemPupilLeft" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemPupilRight" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Banner Character Extras -->
            <DoubleAnimation Storyboard.TargetName="RemBatTranslate" Storyboard.TargetProperty="X" From="-20" To="30" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemBatTranslate" Storyboard.TargetProperty="Y" From="6" To="-12" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemGhostTranslate" Storyboard.TargetProperty="X" From="24" To="-24" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemGhostRotate" Storyboard.TargetProperty="Angle" From="-12" To="12" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Cheering Shoulder Ghosts -->
            <DoubleAnimation Storyboard.TargetName="RemGhostLeftTranslate" Storyboard.TargetProperty="Y" From="0" To="-20" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemGhostLeftRotate" Storyboard.TargetProperty="Angle" From="-10" To="10" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemGhostRightTranslate" Storyboard.TargetProperty="Y" From="0" To="-18" Duration="0:0:1.3">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemGhostRightRotate" Storyboard.TargetProperty="Angle" From="10" To="-10" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Bungee Rappelling Spiders Beside Modal -->
            <DoubleAnimation Storyboard.TargetName="RemSpiderLTranslate" Storyboard.TargetProperty="Y" From="0" To="70" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><BounceEase Bounces="2" Bounciness="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemSpiderLThread" Storyboard.TargetProperty="Y2" From="20" To="90" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemSpiderRTranslate" Storyboard.TargetProperty="Y" From="0" To="65" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction><BounceEase Bounces="2" Bounciness="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemSpiderRThread" Storyboard.TargetProperty="Y2" From="20" To="85" Duration="0:0:2.0">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ======================================================== -->
        <!-- CHRISTMAS AMBIENT CONTINUOUS STORYBOARD                  -->
        <!-- Living Olaf Pet Companion Antics, Snowfall, Fairy Lights -->
        <!-- ======================================================== -->
        <Storyboard x:Key="ChristmasAmbientStoryboard" RepeatBehavior="Forever">
            <!-- 1. Olaf The Snowman Companion Pet Loop in Daily Notes -->
            <!-- Olaf Left Arm Wave -->
            <DoubleAnimation Storyboard.TargetName="OlafArmLeftRotate" Storyboard.TargetProperty="Angle"
                             From="-15" To="45" Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Olaf Right Arm Wave -->
            <DoubleAnimation Storyboard.TargetName="OlafArmRightRotate" Storyboard.TargetProperty="Angle"
                             From="15" To="-30" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Olaf Head Tilt & Bob -->
            <DoubleAnimation Storyboard.TargetName="OlafHeadRotate" Storyboard.TargetProperty="Angle"
                             From="-6" To="8" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OlafHeadTranslate" Storyboard.TargetProperty="Y"
                             From="0" To="-6" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Olaf Carrot Nose Sneeze & Snap Back -->
            <DoubleAnimation Storyboard.TargetName="OlafCarrotTranslate" Storyboard.TargetProperty="X"
                             From="0" To="18" Duration="0:0:3.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><BounceEase Bounces="1" Bounciness="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OlafCarrotTranslate" Storyboard.TargetProperty="Y"
                             From="0" To="-4" Duration="0:0:3.4" AutoReverse="True" RepeatBehavior="Forever" />
            <!-- Olaf Jolly Belly Wobble (Squash & Stretch) -->
            <DoubleAnimation Storyboard.TargetName="OlafBellyScaleX" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.14" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OlafBellyScaleY" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="0.88" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Head Mini Snowball Balance Wobble -->
            <DoubleAnimation Storyboard.TargetName="OlafSnowballTranslate" Storyboard.TargetProperty="X"
                             From="-6" To="6" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OlafSnowballRotate" Storyboard.TargetProperty="Angle"
                             From="-18" To="18" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 2. Falling Snowflakes in Today's Tasks (Left Pane) -->
            <DoubleAnimation Storyboard.TargetName="Snowflake1TranslateY" Storyboard.TargetProperty="Y"
                             From="-25" To="420" Duration="0:0:5.2" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Snowflake1TranslateX" Storyboard.TargetProperty="X"
                             From="-16" To="16" Duration="0:0:1.9" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Snowflake1Rotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:4.0" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="Snowflake2TranslateY" Storyboard.TargetProperty="Y"
                             From="-25" To="420" Duration="0:0:6.8" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Snowflake2TranslateX" Storyboard.TargetProperty="X"
                             From="14" To="-14" Duration="0:0:2.3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Snowflake2Rotate" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:5.5" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="Snowflake3TranslateY" Storyboard.TargetProperty="Y"
                             From="-25" To="420" Duration="0:0:4.7" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Snowflake3TranslateX" Storyboard.TargetProperty="X"
                             From="-20" To="20" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="Snowflake4TranslateY" Storyboard.TargetProperty="Y"
                             From="-25" To="420" Duration="0:0:6.1" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Snowflake4TranslateX" Storyboard.TargetProperty="X"
                             From="18" To="-18" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 3. Falling Snowflakes in Daily Notes (Right Pane) -->
            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes1TranslateY" Storyboard.TargetProperty="Y"
                             From="-25" To="420" Duration="0:0:5.4" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes1TranslateX" Storyboard.TargetProperty="X"
                             From="-14" To="14" Duration="0:0:2.0" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes1Rotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:4.5" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes2TranslateY" Storyboard.TargetProperty="Y"
                             From="-25" To="420" Duration="0:0:6.6" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes2TranslateX" Storyboard.TargetProperty="X"
                             From="16" To="-16" Duration="0:0:2.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes2Rotate" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:5.2" RepeatBehavior="Forever" />

            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes3TranslateY" Storyboard.TargetProperty="Y"
                             From="-25" To="420" Duration="0:0:4.5" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="SnowflakeNotes3TranslateX" Storyboard.TargetProperty="X"
                             From="-12" To="12" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 4. Twinkling Hearth Fairy Lights & Stockings Swing -->
            <DoubleAnimation Storyboard.TargetName="LightGlow1" Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LightGlow2" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1.0" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LightGlow3" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1.0" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="HangingStocking1Rotate" Storyboard.TargetProperty="Angle"
                             From="-10" To="10" Duration="0:0:2.3" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HangingStocking2Rotate" Storyboard.TargetProperty="Angle"
                             From="10" To="-10" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ======================================================== -->
        <!-- CHRISTMAS REMINDER SPECTACLE STORYBOARD                  -->
        <!-- Santa's Sleigh, Flying Reindeer, Ringing Jingle Bells    -->
        <!-- ======================================================== -->
        <Storyboard x:Key="ChristmasReminderStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <!-- Flying Reindeer Swoop -->
            <DoubleAnimation Storyboard.TargetName="RemReindeerTranslate" Storyboard.TargetProperty="X"
                             From="-120" To="120" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemReindeerRotate" Storyboard.TargetProperty="Angle"
                             From="-6" To="10" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Santa Sleigh Rocking Motion -->
            <DoubleAnimation Storyboard.TargetName="RemSleighRock" Storyboard.TargetProperty="Angle"
                             From="-4" To="4" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Ringing Jingle Bells Dynamic Swing -->
            <DoubleAnimation Storyboard.TargetName="RemBell1Rotate" Storyboard.TargetProperty="Angle"
                             From="-30" To="30" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemBell2Rotate" Storyboard.TargetProperty="Angle"
                             From="30" To="-30" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Glowing North Star Radiance -->
            <DoubleAnimation Storyboard.TargetName="RemStarGlow" Storyboard.TargetProperty="BlurRadius"
                             From="16" To="52" Duration="0:0:0.8" />
            <DoubleAnimation Storyboard.TargetName="RemStarGlow" Storyboard.TargetProperty="Opacity"
                             From="0.7" To="1.0" Duration="0:0:0.8" />
            <!-- Santa, Rudolph & Olaf Bounce in Banner -->
            <DoubleAnimation Storyboard.TargetName="RemRudolphBounce" Storyboard.TargetProperty="Y"
                             From="0" To="-12" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction><BounceEase Bounces="1" Bounciness="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemSantaBounce" Storyboard.TargetProperty="Y"
                             From="0" To="-14" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><BounceEase Bounces="1" Bounciness="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RemOlafBannerBounce" Storyboard.TargetProperty="Y"
                             From="0" To="-16" Duration="0:0:0.65">
                <DoubleAnimation.EasingFunction><BounceEase Bounces="1" Bounciness="2" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Gift Sack Squash & Stretch Pulse -->
            <DoubleAnimation Storyboard.TargetName="RemGiftScale" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.16" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <!-- Christmas Banner Glow -->
            <DoubleAnimation Storyboard.TargetName="ChristmasBannerGlow" Storyboard.TargetProperty="BlurRadius"
                             From="14" To="38" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="ChristmasBannerGlow" Storyboard.TargetProperty="Opacity"
                             From="0.65" To="1.0" Duration="0:0:0.7" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Outer Glowing Reminder Border (Normally invisible, pulses when reminder active) -->
        <Border x:Name="ReminderGlowBorder" BorderBrush="{DynamicResource AppPrimaryColor}" BorderThickness="3"
                Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect x:Name="GlowEffect" Color="#FF7E00" BlurRadius="20" ShadowDepth="0" Opacity="0.8" />
            </Border.Effect>
        </Border>

        <!-- Primary Layout Grid Wrapped in Dynamic Outer Frame (3D Beveled in Win95) -->
        <Border Style="{DynamicResource DialogOuterFrameStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Title Bar -->
                    <RowDefinition Height="Auto" /> <!-- Date & Action Bar -->
                    <RowDefinition Height="*" />    <!-- Main 2-Pane Content Area -->
                    <RowDefinition Height="Auto" /> <!-- Status Bar -->
