                                    <Line X1="12" Y1="4" X2="12" Y2="6" Stroke="#BF360C" StrokeThickness="0.6" />
                                </Grid>
                            </Grid>

                            <!-- Festive Subtle "Olaf ⛄" Badge -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1B5E20" BorderBrush="#FFD700"
                                    BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,2,0">
                                <TextBlock Text="Olaf ⛄" FontSize="9" FontWeight="Bold" Foreground="#FFFDF8" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource AppPanelBackground}"
                    BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,1,0,0" Padding="8,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{DynamicResource AppSunkenBorderStyle}" Padding="8,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Storage: " FontSize="11" Foreground="{DynamicResource AppMutedForeground}" />
                            <TextBlock Text="{Binding Settings.DataDirectory}" FontSize="11" Foreground="{DynamicResource AppTextForeground}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{DynamicResource AppSunkenBorderStyle}" Padding="8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Reminders: " FontSize="11" Foreground="{DynamicResource AppMutedForeground}" />
                            <TextBlock Text="{Binding RemindersEnabled, Converter={x:Null}, StringFormat='Active'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryColor}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Active" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RemindersEnabled}" Value="False">
                                                <Setter Property="Text" Value="Off" />
                                                <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- SKELETON PLACEHOLDER LOADING SCREEN (UR-060, UR-061) -->
        <!-- ======================================================== -->
        <Border Background="#FFFCFB" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Titlebar Skeleton -->
                <Border Grid.Row="0" Background="#003366" Padding="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,3 L 21,3 L 21,15 L 15,21 L 3,21 Z" Fill="#FFBF00" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Tasks" Foreground="{DynamicResource AppTitleBarForeground}" FontSize="19"
                                   FontFamily="{DynamicResource AppTitleFontFamily}" />
                    </StackPanel>
                </Border>

                <!-- Navigation Placeholder Bar -->
                <Border Grid.Row="1" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="20,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AppSurfaceBackground}" Width="80" Height="28" Margin="0,0,12,0" />
                        <Border Background="{DynamicResource AppSurfaceBackground}" Width="220" Height="28" />
                    </StackPanel>
                </Border>

                <!-- Main Workspace Skeleton Placeholders -->
                <Grid Grid.Row="2" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Skeleton -->
                    <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <Border Background="{DynamicResource AppSurfaceBackground}" Width="140" Height="16" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <Border Background="{DynamicResource AppSurfaceBackground}" Height="44" Margin="0,0,0,10" />
                            <Border Background="{DynamicResource AppSurfaceBackground}" Height="44" Margin="0,0,0,10" />
                            <Border Background="{DynamicResource AppSurfaceBackground}" Height="44" Margin="0,0,0,10" />
                            <Border Background="{DynamicResource AppSurfaceBackground}" Height="44" Margin="0,0,0,10" />
                        </StackPanel>
                    </Border>

                    <!-- Right Skeleton -->
                    <Border Grid.Column="2" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <Border Background="{DynamicResource AppSurfaceBackground}" Width="120" Height="16" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <Border Background="{DynamicResource AppSurfaceBackground}" Height="140" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Progress Bar with Percentage -->
                <Border Grid.Row="3" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,1,0,0" Padding="24,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LoadingStatusText}" FontSize="12" Foreground="{DynamicResource AppPrimaryColor}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding LoadingProgress, StringFormat='{}{0}%'}" FontSize="14"
                                       FontFamily="{DynamicResource AppMetricFontFamily}" Foreground="{DynamicResource AppPrimaryColor}" />
                        </Grid>
                        <ProgressBar Grid.Row="1" Height="4" Value="{Binding LoadingProgress}" Maximum="100"
                                     Foreground="#003366" Background="#E6ECF2" BorderThickness="0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- REMINDER OVERLAY DIALOG (UR-020, UR-021, UR-022, UR-024) -->
