                <!-- Ambient Floating Halloween Layer (Storybook Living Creature World) -->
                <Grid x:Name="HalloweenAmbientGrid" Grid.RowSpan="4" IsHitTestVisible="False"
                      Visibility="{DynamicResource HalloweenOnlyVis}" Panel.ZIndex="0" ClipToBounds="True">

                    <!-- Top Haunted Storybook Eaves & Vine Tendril Silhouette -->
                    <Path HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="14" Stretch="Fill"
                          Data="M 0,0 L 1060,0 L 1060,4 C 1000,10 960,3 920,8 C 880,12 840,4 800,9 C 760,13 720,5 680,10 C 640,14 600,4 560,9 C 520,13 480,5 440,9 C 400,13 360,4 320,10 C 280,14 240,5 200,9 C 160,13 120,4 80,9 C 40,13 0,4 0,4 Z">
