                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Bat1WingScale" ScaleY="1.0" />
                            </Grid.RenderTransform>
                            <!-- Left Wing -->
                            <Path Data="M 22,14 C 18,5 10,2 2,6 C 4,13 10,17 16,17 C 18,21 22,19 22,14 Z" Fill="#1A0A2A" Stroke="#FF7A00" StrokeThickness="0.7" />
                            <!-- Right Wing -->
                            <Path Data="M 22,14 C 26,5 34,2 42,6 C 40,13 34,17 28,17 C 26,21 22,19 22,14 Z" Fill="#1A0A2A" Stroke="#FF7A00" StrokeThickness="0.7" />
                            <!-- Bat Head & Body with Pointy Ears -->
                            <Ellipse Width="10" Height="14" Fill="#0D0316" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Polygon Points="19,5 21,10 18,10" Fill="#0D0316" />
                            <Polygon Points="25,5 23,10 26,10" Fill="#0D0316" />
                            <!-- Glowing Amber Eyes -->
                            <Ellipse Width="2" Height="2" Fill="#FFFF55" Margin="0,0,4,2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="2" Height="2" Fill="#FFFF55" Margin="4,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Grid.Effect>
                            <DropShadowEffect Color="#FF6B00" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                        </Grid.Effect>
                    </Grid>

                    <!-- Flying Vector Bat 2 (Swooping Playful Flutter) -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,320,0" Width="36" Height="22" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="Bat2Translate" X="0" Y="0" />
