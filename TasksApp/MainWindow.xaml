                        <!-- Ghost Cheerful Eyes & Open Mouth -->
                        <Ellipse Width="3.5" Height="4.5" Fill="#120A2A" Margin="0,0,9,14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="3.5" Height="4.5" Fill="#120A2A" Margin="9,0,0,14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="4" Height="5.5" Fill="#120A2A" Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Rosy Cheeks -->
