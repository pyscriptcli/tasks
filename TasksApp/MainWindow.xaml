                                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <!-- Done Check SVG -->
                                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 10,16.4 L 5.6,12 L 7,10.6 L 10,13.6 L 17,6.6 L 18.4,8 Z"
                                                              Fill="#2E7D32">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <!-- Pending Circle SVG -->
                                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z"
                                                              Fill="{DynamicResource AppPrimaryColor}">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                           FontFamily="{DynamicResource AppBaseFontFamily}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AppTextForeground}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppMutedForeground}" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Status Badge (PENDING or DONE) -->
                                                <Border Grid.Column="2" Padding="6,2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold" FontFamily="{DynamicResource AppBaseFontFamily}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="PENDING" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AppPrimaryColor}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Text" Value="DONE" />
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Actions: Dismiss & Snooze Options (UR-024) -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Snooze Presets with SVG Clock Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z M 12.5,7 L 11,7 L 11,13 L 16,16 L 16.8,14.8 L 12.5,12.2 Z"
                                          Fill="{DynamicResource AppMutedForeground}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="SNOOZE: " FontSize="11" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource AppBaseFontFamily}" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="10M" Style="{DynamicResource SecondaryActionBtn}" Margin="0,0,4,0" Padding="8,4"
                                    Command="{Binding SnoozeReminderCommand}" CommandParameter="10" />
                            <Button Content="30M" Style="{DynamicResource SecondaryActionBtn}" Margin="0,0,4,0" Padding="8,4"
                                    Command="{Binding SnoozeReminderCommand}" CommandParameter="30" />
                            <Button Content="1H" Style="{DynamicResource SecondaryActionBtn}" Padding="8,4"
                                    Command="{Binding SnoozeReminderCommand}" CommandParameter="60" />
                        </StackPanel>

                        <!-- Dismiss Button -->
                        <Button Grid.Column="2" Content="DISMISS" Style="{DynamicResource GoldActionBtn}"
                                Command="{Binding DismissReminderCommand}" />
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
