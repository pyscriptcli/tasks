                                    <GradientStop Color="#C5E8F8" Offset="0.6" />
                                    <GradientStop Color="#80D8FF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Ellipse Width="4" Height="5" Fill="#100A25" Margin="0,0,10,16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="4" Height="5" Fill="#100A25" Margin="10,0,0,16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="4.5" Height="6" Fill="#100A25" Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="18" ShadowDepth="0" Opacity="0.8" />
                        </Grid.Effect>
                    </Grid>

                    <!-- Cheering Ghostling Peeking on Right Pumpkin Shoulder -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,-25,0" Width="44" Height="54" RenderTransformOrigin="0.5,0.8">
                        <Grid.RenderTransform>
                            <TransformGroup>
